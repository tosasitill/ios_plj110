+SweetSurface *
+sweet_surface_create_cached(uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+    uint64_t bytes = (uint64_t)bytesPerRow * height;
+    if (!width || !height || width > SWEET_SURFACE_MAX_DIM ||
+        height > SWEET_SURFACE_MAX_DIM || bytesPerRow < (uint64_t)width * 4 ||
+        bytes > SWEET_SURFACE_WIRED_MAX || round_page(bytes) > UINT32_MAX) {
+        return NULL;
+    }
+    SweetSurface *s = sweet_surface_alloc();
+    if (!s) {
+        return NULL;
+    }
+    s->width = width;
+    s->height = height;
+    s->bytesPerRow = bytesPerRow;
+    s->bytesPerElement = 4;
+    s->elementWidth = s->elementHeight = 1;
+    s->pixelFormat = pixelFormat;
+    s->allocSize = (uint32_t)round_page(bytes);
+    uint64_t before = (uint64_t)OSAddAtomic64(s->allocSize,
+        (volatile SInt64 *)&sweet_surface_wired);
+    if (before + s->allocSize > SWEET_SURFACE_WIRED_MAX) {
+        OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+        s->release();
+        return NULL;
+    }
+    IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+        kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+    if (!mem) {
+        OSAddAtomic64(-(SInt64)s->allocSize, (volatile SInt64 *)&sweet_surface_wired);
+        s->release();
+        return NULL;
+    }
+    s->memory = mem;
+    s->mapCache = kIOMapDefaultCache;
+    bzero(mem->getBytesNoCopy(), s->allocSize);
+    if (!sweet_surface_publish(s)) {
+        s->release();
+        return NULL;
+    }
+    return s;
+}
