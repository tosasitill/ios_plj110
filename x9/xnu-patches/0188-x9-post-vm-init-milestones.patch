+void sweet_diag_entry_reset(unsigned int stage);
+#else
+static inline void sweet_diag_entry_reset(unsigned int stage) { (void)stage; }
+#endif
+void sweet_bootstrap_mark(const char *message);
 void sweet_early_putc(char c);
 void sweet_early_panic(const char *fmt, va_list *args);
 void sweet_early_relocate(uint64_t base);
@@ -55,6 +79,15 @@
 	(void)stage;
 	(void)label;
 }
+static inline void sweet_diag_checkpoint(unsigned int stage, const char *label)
+{
+	(void)stage;
+	(void)label;
+}
+static inline void sweet_bootstrap_mark(const char *message)
+{
+	(void)message;
+}
