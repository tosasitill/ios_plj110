X9: enable captured MT6993 PSCI CPU IDs and normalize secondary EL2 entry

Topology IDs are from the captured device FDT; this does not assert hardware boot.
References: UniXNU ae687009348296e97e49ce6e925795044f363ce6 native-smp-secondary.patch;
hackios c84b4634277a70beac73921029b1fb6afc2530af psci_smp.c.

diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -20,7 +20,17 @@
 #include "SweetBoard.h"
 
 extern "C" void sweet_secondary_entry(void);
+extern "C" void sweet_x9_secondary_entry(void);
 extern "C" boolean_t sweet_cpu_signal_is_enabled(unsigned int cpu);
+
+/* X9 FDT hardware IDs use Aff1 = core index. The boot core must be 0. */
+static bool
+sweet_x9_cpu_valid(const ml_topology_info_t *topology, const ml_topology_cpu_t *cpu)
+{
+ return cpu != NULL && topology != NULL && cpu->cpu_id < 8 &&
+     cpu->phys_id == (cpu->cpu_id << 8) && topology->boot_cpu != NULL &&
+     topology->boot_cpu->cpu_id == 0 && topology->boot_cpu->phys_id == 0;
+}
 
 class SweetCPU;
 static SweetCPU *sweet_cpus[MAX_CPUS];
@@ -79,9 +89,8 @@
 		/* x676c (MT6789): MPIDR Aff1 = core: 0x000-0x500 A55, 0x600/0x700 A76 */
 		valid = cpu->phys_id <= 0x700 && (cpu->phys_id & 0xff) == 0;
 	} else if (sweet_board_x9()) {
-		/* MT6993 baseline: only the actual boot CPU, not an SMP topology. */
-		valid = topology->num_cpus == 1 && cpu->cpu_id == 0 &&
-		    cpu == topology->boot_cpu && cpu->phys_id == 0;
+		/* Captured MT6993 FDT uses 0x000..0x700 at Aff1:Aff0. */
+		valid = sweet_x9_cpu_valid(topology, cpu);
 	} else {
 		/* topaz (SM6225): MPIDR Aff1 = cluster, Aff0 = core: 0x0-0x3 A53, 0x100-0x103 A73 */
 		valid = (cpu->phys_id >> 8) <= 1 && (cpu->phys_id & 0xff) <= 3;
@@ -93,7 +102,7 @@
 	if (!IOCPU::start(provider)) {
 		return false;
 	}
-	cpuName = OSSymbol::withCStringNoCopy(sweet_board_x9() ? "MT6993 cpu0" :
+	cpuName = OSSymbol::withCStringNoCopy(sweet_board_x9() ? "MT6993 core" :
 	    sweet_board_x676c() ? (cpu->phys_id >= 0x600 ? "Cortex-A76" : "Cortex-A55") : "Kryo 260");
 	if (cpuName == NULL) {
 		return false;
@@ -257,7 +266,7 @@
 	    __atomic_load_n(&initialized, __ATOMIC_ACQUIRE) != 0) {
 		panic("SWEET CPU: cpu=%u unsupported restart", getCPUNumber());
 	}
-	vm_offset_t entry = ml_static_vtop((vm_offset_t)&sweet_secondary_entry);
+	vm_offset_t entry = ml_static_vtop((vm_offset_t)(sweet_board_x9() ? &sweet_x9_secondary_entry : &sweet_secondary_entry));
 	IOLog("SWEET CPU: cpu=%u CPU_ON target=0x%x entry_pa=0x%llx context=%u\n",
 	    getCPUNumber(), cpu->phys_id, (uint64_t)entry, getCPUNumber());
 	__builtin_arm_dsb(DSB_SY);
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -327,6 +327,71 @@
 	/* x0 is deliberately unused; reset_vector selects CPU data by MPIDR. */
 	msr		SPSel, #1
 	b		EXT(LowResetVectorBase)
+
+/* X9 secondary entry. Preserve the proven EL2 -> EL1 order from x9/shim/start.S.
+ * x0 is PSCI context, deliberately unused; the MPIDR selects cpu_data. */
+	.align 2
+	.globl EXT(sweet_x9_secondary_entry)
+LEXT(sweet_x9_secondary_entry)
+	msr		DAIFSet, #0xf
+	mrs		x1, CurrentEL
+	cmp		x1, #0x4
+	b.eq	Lsweet_x9_secondary_el1
+	cmp		x1, #0x8
+	b.ne	Lsweet_x9_secondary_bad_el
+	/* Under VHE, VBAR_EL2 aliases the EL1&0 vector base until E2H is clear. */
+	mov		x1, #(1 << 31)
+	msr		HCR_EL2, x1
+	isb
+	adrp	x1, EXT(LowExceptionVectorBase)@page
+	add		x1, x1, EXT(LowExceptionVectorBase)@pageoff
+	msr		VBAR_EL2, x1
+	isb
+	/* Clear FEAT_FGT traps only if the feature is implemented. */
+	mrs		x1, ID_AA64MMFR0_EL1
+	ubfx	x2, x1, #56, #4
+	cbz		x2, Lsweet_x9_secondary_no_fgt
+	.arch armv8.6-a
+	msr		HFGITR_EL2, xzr
+	msr		HFGRTR_EL2, xzr
+	msr		HFGWTR_EL2, xzr
+	.arch armv8-a
+	isb
+Lsweet_x9_secondary_no_fgt:
+	msr		VTTBR_EL2, xzr
+	msr		CPTR_EL2, xzr
+	msr		MDCR_EL2, xzr
+	mov		x1, #3
+	msr		CNTHCTL_EL2, x1
+	msr		CNTVOFF_EL2, xzr
+	MOV64	x1, 0x30d00800
+	msr		SCTLR_EL1, x1
+	mrs		x1, MIDR_EL1
+	msr		VPIDR_EL2, x1
+	mrs		x1, MPIDR_EL1
+	msr		VMPIDR_EL2, x1
+	mrs		x1, ID_AA64PFR0_EL1
+	ubfx	x2, x1, #24, #4
+	cbz		x2, Lsweet_x9_secondary_no_gic
+	mrs		x1, ICC_SRE_EL2
+	orr		x1, x1, #1
+	orr		x1, x1, #8
+	msr		ICC_SRE_EL2, x1
+	isb
+	msr		ICH_HCR_EL2, xzr
+Lsweet_x9_secondary_no_gic:
+	adrp	x1, Lsweet_x9_secondary_el1@page
+	add		x1, x1, Lsweet_x9_secondary_el1@pageoff
+	msr		ELR_EL2, x1
+	mov		x1, #0x3c5
+	msr		SPSR_EL2, x1
+	isb
+	eret
+Lsweet_x9_secondary_bad_el:
+	b		.
+Lsweet_x9_secondary_el1:
+	msr		SPSel, #1
+	b		EXT(LowResetVectorBase)
 #endif /* SWEET */
 
 	.align 2
