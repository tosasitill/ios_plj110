From: HelioDarwin
Subject: [PATCH] x9: mark autoconfiguration through root-selection entry

Add named observation points after BSD autoconfiguration, network clients and
calendar setup, and immediately before setconf. Default reset policy unchanged.

diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -402,6 +402,10 @@
 	{ "bsd_network_ready", 88 },
 	{ "bsd_sysctl_ready", 89 },
 	{ "bsd_autoconf_enter", 90 },
+	{ "bsd_autoconf_ready", 91 },
+	{ "bsd_net_clients_ready", 92 },
+	{ "bsd_calendar_ready", 93 },
+	{ "bsd_root_select_enter", 99 },
 };
 
 /*
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -823,6 +823,7 @@
 	bsd_init_kprintf("calling bsd_autoconf\n");
 	sweet_bsd_mark(90, "bsd_autoconf_enter");
 	bsd_autoconf();
+	sweet_bsd_mark(91, "bsd_autoconf_ready");
 
 #if CONFIG_DTRACE
 	dtrace_postinit();
@@ -888,15 +889,18 @@
 	bsd_init_kprintf("calling net_init_run\n");
 	net_init_run();
 #endif /* NETWORKING */
+	sweet_bsd_mark(92, "bsd_net_clients_ready");
 
 	bsd_init_kprintf("calling inittodr\n");
 	inittodr(0);
+	sweet_bsd_mark(93, "bsd_calendar_ready");
 
 	/* Mount the root file system. */
 	while (TRUE) {
 		int err;
 
 		bsd_init_kprintf("calling setconf\n");
+		sweet_bsd_mark(99, "bsd_root_select_enter");
 		setconf();
 #if CONFIG_NETBOOT
 		netboot = (mountroot == netboot_mountroot);
