+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern boolean_t sweet_x9_ufs_root_active(void);
+
+/* An opt-in initial environment for the original dyld on our HFS root.
+ * libignition level 1 skips APFS Preboot discovery. The complete, original
+ * cache remains at its populated Cryptex path; no filesystem alias or write.
+ * Only PID 1 receives this variable. Later processes can reuse the shared region.
+ */
+static int
+sweet_x9_init_cache_env(proc_t p, user_addr_t cursor, user_addr_t end,
+    user_addr_t *envp)
+{
+	static const char cache_env[] =
+	    "DYLD_SHARED_CACHE_DIR=/private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld";
+	int enabled = 0;
+	int error;
+	user_addr_t vector;
+	user64_addr_t entries[2] = { cursor, USER_ADDR_NULL };
+
+	*envp = USER_ADDR_NULL;
+	if (!proc_is64bit(p) || !sweet_x9_ufs_root_active() ||
+	    !PE_parse_boot_argn("x9_init_cache", &enabled, sizeof(enabled)) || enabled != 1) {
+		return 0;
+	}
+	if (cursor > end || sizeof(cache_env) > end - cursor) {
+		return E2BIG;
+	}
+	vector = USER_ADDR_ALIGN(cursor + sizeof(cache_env), sizeof(user64_addr_t));
+	if (vector < cursor || vector > end || sizeof(entries) > end - vector) {
+		return E2BIG;
+	}
+	error = copyout(cache_env, cursor, sizeof(cache_env));
+	if (error) {
+		return error;
+	}
+	error = copyout(entries, vector, sizeof(entries));
+	if (error) {
+		return error;
+	}
+	*envp = vector;
+	printf("X9 init: PID1 DYLD_SHARED_CACHE_DIR=/private/preboot/Cryptexes/OS/System/Library/Caches/com.apple.dyld\n");
+	return 0;
+}
+#endif
