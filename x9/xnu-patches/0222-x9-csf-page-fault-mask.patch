+/* CSF kbase_mmu_interrupt consumes only IRQ bits0..15 (page faults).
+ * CSF bus faults are reported through GPU_IRQ/GPU_FAULTSTATUS, unlike JM's
+ * legacy MMU_BUS_ERROR(n)=1<<(n+16). Do not treat upper MMU bits as bus faults. */
 static bool no_faults(vm_offset_t gpu) {
  uint32_t mmu=gr(gpu,0x2000),irq=gr(gpu,0x20),mcu=gr(gpu,0x704);
  if(mmu==0xffffffffu||irq==0xffffffffu||mcu==0xffffffffu||
-    (mmu&0x10001u)||(irq&3)||mcu==3) {
+    (mmu&0xffffu)||(irq&3)||mcu==3) {
   IOLog("X9 CSF BOOT: fault irq=%08x mmu=%08x mcu=%08x GPUstatus=%08x GPUaddr=%llx ASstatus=%08x ASaddr=%llx\n",
    irq,mmu,mcu,gr(gpu,0x3c),gr64(gpu,0x40),gr(gpu,0x241c),gr64(gpu,0x2420));return false;
  }
@@ -312,8 +315,11 @@
  if(!idle_as(gpu))return false;
  gw64(gpu,0x2430,transcfg);gw64(gpu,0x2400,root);gw64(gpu,0x2408,memattr);
  gw(gpu,0x2418,1);
- return idle_as(gpu)&&gr64(gpu,0x2400)==root&&gr64(gpu,0x2408)==memattr&&
-  gr64(gpu,0x2430)==transcfg&&no_faults(gpu);
+  if(!idle_as(gpu))return false;
+ uint64_t actual_root=gr64(gpu,0x2400),actual_attr=gr64(gpu,0x2408),actual_cfg=gr64(gpu,0x2430);
+ IOLog("X9 CSF BOOT: AS0 UPDATE root=%llx attr=%llx cfg=%llx MMUraw=%08x ASstatus=%08x\n",
+  actual_root,actual_attr,actual_cfg,gr(gpu,0x2000),gr(gpu,0x2428));
+ return actual_root==root&&actual_attr==memattr&&actual_cfg==transcfg&&no_faults(gpu);
 }
 static bool remove_as(vm_offset_t gpu,uint64_t saved_attr,uint64_t saved_cfg) {
  if(!idle_as(gpu))return false;
@@ -468,7 +474,7 @@
   p.device_exposed=false;
   if(gr(gpu,0x1000)&0x80000000u)gw(gpu,0x1004,0x80000000u);
   if(gr(gpu,0x20)&(1u<<19))gw(gpu,0x24,1u<<19);
-  uint32_t ours=gr(gpu,0x2000)&0x10001u;
+  uint32_t ours=gr(gpu,0x2000)&1u;
   if(ours)gw(gpu,0x2004,ours);
  }
  if(masked){gw(gpu,0x28,gpu_mask);gw(gpu,0x1008,job_mask);}
