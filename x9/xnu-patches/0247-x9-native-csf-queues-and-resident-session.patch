diff --git a/iokit/Kernel/arm/X9CSFRenderQueue.h b/iokit/Kernel/arm/X9CSFRenderQueue.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/X9CSFRenderQueue.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include "X9CSFInterfaces.h"
+#include "X9RenderKernel.h"
+/* Accessors operate on the retained AS0 firmware allocation, including cache
+ * maintenance. All calls require the single GPU owner lock. now_ns uses a
+ * monotonic clock; doorbell() rings the real kernel DB, not a synthetic ACK. */
+struct X9CSFQueueIO {
+ void *cookie;
+ bool (*read32)(void *,uint32_t,uint32_t *);
+ bool (*write32)(void *,uint32_t,uint32_t);
+ bool (*clean)(void *,uint32_t,uint32_t);
+ bool (*healthy)(void *);
+ bool (*doorbell)(void *);
+ uint64_t (*now_ns)(void *);
+ void (*yield)(void *);
+};
+struct X9CSFStreamBinding { uint64_t ring,user_input,user_output;uint32_t ring_bytes; };
+struct X9CSFRenderGroup {
+ X9CSFGroupInterface interface;
+ X9CSFStreamBinding streams[3];
+ uint64_t firmware_epoch;
+ uint32_t streams_touched;
+ bool touched,running,suspended,uncertain;
+};
+IOReturn x9_csf_group_configure(const X9CSFQueueIO *,X9CSFRenderGroup *,const X9CSFGroupInterface *,
+ const X9RenderGroup *,const X9CSFStreamBinding [3],uint64_t suspend_va,uint64_t epoch);
+IOReturn x9_csf_group_start(const X9CSFQueueIO *,X9CSFRenderGroup *,uint64_t epoch,uint64_t timeout_ns);
+IOReturn x9_csf_group_halt(const X9CSFQueueIO *,X9CSFRenderGroup *,uint64_t epoch,bool suspend,uint64_t timeout_ns);
+/* Checks firmware faults and tiler OOM, not rendering correctness or DMA idle. */
+IOReturn x9_csf_group_health(const X9CSFQueueIO *,const X9CSFRenderGroup *,uint64_t epoch);
diff --git a/iokit/Kernel/arm/X9CSFRenderQueue.cpp b/iokit/Kernel/arm/X9CSFRenderQueue.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/X9CSFRenderQueue.cpp
@@ -0,0 +1,158 @@
+/* SPDX-License-Identifier: MIT */
+#include "X9CSFRenderQueue.h"
+#include <libkern/libkern.h>
+/* MT6993 a16w mali_kbase_csf_registers.h/scheduler.c: GPU arch>=14.8.4
+ * uses the64-bit endpoint request at+0x38. This module is X9/e8800010 only.
+ * It changes firmware-owned interfaces through a real DMA accessor; it does
+ * not allocate AS0/AS1, delegate power, or bypass required ownership gates. */
+namespace {
+constexpr uint32_t state_mask=7,cs_start=1,csg_start=1,csg_suspend=2,csg_resume=3;
+constexpr uint32_t faults=0xc0000000u,oom=1u<<26;
+static bool valid(const X9CSFQueueIO *io) {
+ return io&&io->read32&&io->write32&&io->clean&&io->healthy&&io->doorbell&&io->now_ns&&io->yield;
+}
+static bool read(const X9CSFQueueIO *io,uint32_t va,uint32_t *value){return io->read32(io->cookie,va,value);}
+static bool write(const X9CSFQueueIO *io,uint32_t va,uint32_t value){return io->write32(io->cookie,va,value);}
+static bool write64(const X9CSFQueueIO *io,uint32_t va,uint64_t value) {
+ return write(io,va,(uint32_t)value)&&write(io,va+4,(uint32_t)(value>>32));
+}
+static bool clean(const X9CSFQueueIO *io,uint32_t va,uint32_t bytes){return io->clean(io->cookie,va,bytes);}
+static bool set_state(const X9CSFQueueIO *io,uint32_t va,unsigned state) {
+ uint32_t old;return read(io,va,&old)&&write(io,va,(old&~state_mask)|state);
+}
+static bool notify(const X9CSFQueueIO *io,X9CSFRenderGroup *group,bool streams,uint32_t *global_req,uint32_t *group_req) {
+ const auto &f=group->interface;
+ if(streams) {
+  uint32_t old,ack,mask=group->streams_touched;
+  if(!read(io,f.group_input+8,&old)||!read(io,f.group_output+8,&ack))return false;
+  *group_req=(old&~mask)|((ack^mask)&mask);
+  if(!write(io,f.group_input+8,*group_req)||!clean(io,f.group_input,0x70))return false;
+ }
+ uint32_t old,ack,mask=1u<<f.group_index;
+ if(!read(io,f.global_input+8,&old)||!read(io,f.global_output+8,&ack))return false;
+ *global_req=(old&~mask)|((ack^mask)&mask);
+ return write(io,f.global_input+8,*global_req)&&clean(io,f.global_input,4096)&&io->doorbell(io->cookie);
+}
+static IOReturn wait_ack(const X9CSFQueueIO *io,X9CSFRenderGroup *g,unsigned state,bool streams,
+ uint32_t global_req,uint32_t group_req,uint64_t epoch,uint64_t end) {
+ for(;;) {
+  IOReturn health=x9_csf_group_health(io,g,epoch);if(health!=kIOReturnSuccess)return health;
+  uint32_t global_ack,group_ack,ack;
+  if(!read(io,g->interface.global_output+8,&global_ack)||!read(io,g->interface.group_output+8,&group_ack)||
+     !read(io,g->interface.group_output,&ack))return kIOReturnIOError;
+  bool ready=!((global_ack^global_req)&(1u<<g->interface.group_index));
+  if(streams) {
+   ready=ready&&!((group_ack^group_req)&g->streams_touched);
+   for(unsigned i=0;i<3;i++)if(g->streams_touched&(1u<<i)) {
+    uint32_t cs_ack;if(!read(io,g->interface.streams[i].output,&cs_ack))return kIOReturnIOError;
+    if((cs_ack&state_mask)!=state)ready=false;
+   }
+  }else ready=ready&&(ack&state_mask)==state;
+  if(ready)return kIOReturnSuccess;
+  if(io->now_ns(io->cookie)>=end)return kIOReturnTimeout;
+  io->yield(io->cookie);
+ }
+}
+static bool deadline(const X9CSFQueueIO *io,uint64_t timeout,uint64_t *end) {
+ if(!timeout||timeout>10000000000ULL)return false;
+ uint64_t now=io->now_ns(io->cookie);if(timeout>UINT64_MAX-now)return false;*end=now+timeout;return true;
+}
+}
+IOReturn x9_csf_group_health(const X9CSFQueueIO *io,const X9CSFRenderGroup *g,uint64_t epoch) {
+ if(!valid(io)||!g||!epoch||g->firmware_epoch!=epoch)return kIOReturnBadArgument;
+ if(g->uncertain||!io->healthy(io->cookie))return kIOReturnNotReady;
+ uint32_t req,ack;
+ if(!read(io,g->interface.global_input,&req)||!read(io,g->interface.global_output,&ack))return kIOReturnIOError;
+ if((req^ack)&(1u<<27))return kIOReturnIOError; /* global fatal */
+ for(unsigned i=0;i<3;i++)if(g->streams_touched&(1u<<i)) {
+  if(!read(io,g->interface.streams[i].input,&req)||!read(io,g->interface.streams[i].output,&ack))return kIOReturnIOError;
+  if((req^ack)&faults)return kIOReturnIOError;
+  /* Do not fake an OOM acknowledgment or reset a faulting group. The owner
+   * must handle the heap event or retain resources on failed quiescence. */
+  if((req^ack)&oom)return kIOReturnNoMemory;
+ }
+ return kIOReturnSuccess;
+}
+IOReturn x9_csf_group_configure(const X9CSFQueueIO *io,X9CSFRenderGroup *g,const X9CSFGroupInterface *f,
+ const X9RenderGroup *request,const X9CSFStreamBinding bindings[3],uint64_t suspend_va,uint64_t epoch) {
+ if(!valid(io)||!g||!f||!request||!bindings||!epoch||g->touched||g->uncertain||
+    f->group_index>=16||f->stream_count!=3||request->stream_count!=3||
+    request->abi!=X9_RENDER_ABI||!request->compute_mask||!request->fragment_mask||request->tiler_mask!=1||
+    !request->max_compute||request->max_compute>__builtin_popcountll(request->compute_mask)||
+    !request->max_fragment||request->max_fragment>__builtin_popcountll(request->fragment_mask)||
+    request->max_tiler!=1||request->priority>1||!suspend_va||(suspend_va&4095)||
+    suspend_va>UINT32_MAX-f->suspend_bytes)return kIOReturnBadArgument;
+ if(!io->healthy(io->cookie))return kIOReturnNotReady;
+ uint32_t req,ack;
+ if(!read(io,f->group_input,&req)||!read(io,f->group_output,&ack)||((req|ack)&state_mask))return kIOReturnBusy;
+ for(unsigned i=0;i<3;i++) {
+  const auto &b=bindings[i];
+  if(!b.ring||(b.ring&4095)||b.ring_bytes<4096||b.ring_bytes>(1u<<20)||
+     (b.ring_bytes&(b.ring_bytes-1))||b.ring>=1ULL<<48||b.ring_bytes>(1ULL<<48)-b.ring||
+     !b.user_input||!b.user_output||((b.user_input|b.user_output)&4095)||
+     b.user_input>UINT32_MAX-4096u||b.user_output>UINT32_MAX-4096u||
+     (b.user_input<b.user_output+4096&&b.user_output<b.user_input+4096))return kIOReturnBadArgument;
+  if(!read(io,f->streams[i].input,&req)||!read(io,f->streams[i].output,&ack)||
+     ((req|ack)&state_mask)||((req^ack)&(faults|oom)))return kIOReturnBusy;
+ }
+ /* Mark device exposure before the first host input write. Even failure before
+  * ringing must go through owner-controlled STOP/TERMINATE and AS cleanup. */
+ *g={};g->interface=*f;g->firmware_epoch=epoch;g->touched=true;g->streams_touched=7;
+ memcpy(g->streams,bindings,sizeof(g->streams));
+ for(unsigned i=0;i<3;i++) {
+  uint32_t input=f->streams[i].input;const auto &b=bindings[i];
+  if(!write64(io,input+0x10,b.ring)||!write(io,input+0x18,b.ring_bytes)||
+     !write64(io,input+0x30,b.user_input)||!write64(io,input+0x38,b.user_output)||
+     !write(io,input+4,1u<<8)||!write(io,input+0xc,0xffffffffu)||!clean(io,input,0x60))goto failed;
+ }
+ if(!write64(io,f->group_input+0x18,0)||!write64(io,f->group_input+0x20,request->compute_mask)||
+    !write64(io,f->group_input+0x28,request->fragment_mask)||!write(io,f->group_input+0x30,1)||
+    !write64(io,f->group_input+0x38,(uint64_t)request->max_compute|((uint64_t)request->max_fragment<<8)|
+      (1ULL<<16)|((uint64_t)request->priority<<28))||
+    !write64(io,f->group_input+0x40,suspend_va)||!write64(io,f->group_input+0x48,0)||
+    !write(io,f->group_input+0x50,1)||!write(io,f->group_input+4,0xffffffffu)||
+    !clean(io,f->group_input,0x70))goto failed;
+ return kIOReturnSuccess;
+failed:g->uncertain=true;return kIOReturnIOError;
+}
+IOReturn x9_csf_group_start(const X9CSFQueueIO *io,X9CSFRenderGroup *g,uint64_t epoch,uint64_t timeout) {
+ if(!valid(io)||!g||!g->touched||g->running||g->uncertain||g->firmware_epoch!=epoch)return kIOReturnBadArgument;
+ uint64_t end;if(!deadline(io,timeout,&end))return kIOReturnBadArgument;
+ for(unsigned i=0;i<3;i++) {
+  uint32_t input=g->interface.streams[i].input,old;
+  if(!read(io,input,&old)||!write(io,input,(old&~state_mask)|cs_start|(1u<<8)|(1u<<10)|(1u<<12))||!clean(io,input,0x60))goto failed;
+ }
+ if(!set_state(io,g->interface.group_input,g->suspended?csg_resume:csg_start)||!clean(io,g->interface.group_input,0x70))goto failed;
+ {
+  uint32_t global=0,group=0;
+  if(!notify(io,g,true,&global,&group))goto failed;
+  IOReturn kr=wait_ack(io,g,g->suspended?csg_resume:csg_start,false,global,group,epoch,end);
+  if(kr!=kIOReturnSuccess){g->uncertain=true;return kr;}
+  kr=wait_ack(io,g,cs_start,true,global,group,epoch,end);
+  if(kr!=kIOReturnSuccess){g->uncertain=true;return kr;}
+ }
+ g->running=true;g->suspended=false;return kIOReturnSuccess;
+failed:g->uncertain=true;return kIOReturnIOError;
+}
+IOReturn x9_csf_group_halt(const X9CSFQueueIO *io,X9CSFRenderGroup *g,uint64_t epoch,bool suspend,uint64_t timeout) {
+ if(!valid(io)||!g||g->firmware_epoch!=epoch||g->uncertain)return kIOReturnBadArgument;
+ if(!g->touched)return kIOReturnSuccess;
+ uint64_t end;if(!deadline(io,timeout,&end))return kIOReturnBadArgument;
+ /* SUSPEND preserves all stream register state atomically. Issuing per-stream
+  * STOP first would change saved state and break RESUME. TERMINATE matches the
+  * proven CS0 STOP then CSG TERMINATE protocol, extended to all three streams. */
+ if(!suspend) {
+  for(unsigned i=0;i<3;i++)if(!set_state(io,g->interface.streams[i].input,0)||!clean(io,g->interface.streams[i].input,0x60))goto failed;
+  uint32_t global=0,group=0;if(!notify(io,g,true,&global,&group))goto failed;
+  IOReturn kr=wait_ack(io,g,0,true,global,group,epoch,end);
+  if(kr!=kIOReturnSuccess){g->uncertain=true;return kr;}
+ }
+ if(!set_state(io,g->interface.group_input,suspend?csg_suspend:0)||!clean(io,g->interface.group_input,0x70))goto failed;
+ {
+  uint32_t global=0,group=0;if(!notify(io,g,false,&global,&group))goto failed;
+  IOReturn kr=wait_ack(io,g,suspend?csg_suspend:0,false,global,group,epoch,end);
+  if(kr!=kIOReturnSuccess){g->uncertain=true;return kr;}
+ }
+ g->running=false;g->suspended=suspend;if(!suspend){g->touched=false;g->streams_touched=0;}return kIOReturnSuccess;
+failed:g->uncertain=true;return kIOReturnIOError;
+}
diff --git a/iokit/Kernel/arm/X9CSFQueueAccess.h b/iokit/Kernel/arm/X9CSFQueueAccess.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/X9CSFQueueAccess.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include "X9CSFRenderQueue.h"
+/* Held for the entire powered firmware session. The engine owns descriptor
+ * references/prepares and verifies MMIO mappings against the X9 FDT contract. */
+struct X9CSFSharedRange {
+ IOBufferMemoryDescriptor *memory;
+ uint32_t gpu_va,bytes;
+};
+struct X9CSFQueueAccess {
+ X9CSFSharedRange ranges[64];
+ uint32_t range_count;
+ X9CSFGroupInterface interface;
+ vm_offset_t gpu,kernel_doorbell;
+ uint64_t epoch;
+ bool owned;
+};
+bool x9_csf_queue_access_init(X9CSFQueueAccess *,const X9CSFSharedRange *,uint32_t,
+ const X9CSFGroupInterface *,vm_offset_t,vm_offset_t,uint64_t);
+X9CSFQueueIO x9_csf_queue_access_io(X9CSFQueueAccess *);
+/* Called only after the hardware owner confirms MCU stop/AS0 detach. */
+void x9_csf_queue_access_invalidate(X9CSFQueueAccess *);
diff --git a/iokit/Kernel/arm/X9CSFQueueAccess.cpp b/iokit/Kernel/arm/X9CSFQueueAccess.cpp
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/X9CSFQueueAccess.cpp
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT */
+#include "X9CSFQueueAccess.h"
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+namespace {
+static void *address(X9CSFQueueAccess *a,uint32_t va,uint32_t bytes) {
+ if(!a||!a->owned||!bytes)return nullptr;
+ for(unsigned i=0;i<a->range_count;i++) {
+  const auto &r=a->ranges[i];
+  if(va>=r.gpu_va&&(uint64_t)va+bytes<=(uint64_t)r.gpu_va+r.bytes)
+   return (uint8_t *)r.memory->getBytesNoCopy()+(va-r.gpu_va);
+ }
+ return nullptr;
+}
+static bool host_input(const X9CSFQueueAccess *a,uint32_t va,uint32_t bytes) {
+ const auto &f=a->interface;
+ if(va>=f.global_input&&(uint64_t)va+bytes<=(uint64_t)f.global_input+4096)return true;
+ if(va>=f.group_input&&(uint64_t)va+bytes<=(uint64_t)f.group_input+0x70)return true;
+ for(unsigned i=0;i<3;i++)if(va>=f.streams[i].input&&(uint64_t)va+bytes<=(uint64_t)f.streams[i].input+0x60)return true;
+ return false;
+}
+static void cache(void *ptr,uint32_t bytes,bool invalidate) {
+ uint64_t ctr;__asm__ volatile("mrs %0,ctr_el0":"=r"(ctr));
+ uint64_t line=4ULL<<((ctr>>16)&15);
+ uintptr_t begin=(uintptr_t)ptr&~(line-1),end=(uintptr_t)ptr+bytes;
+ __asm__ volatile("dsb sy":::"memory");
+ for(uintptr_t at=begin;at<end;at+=line) {
+  if(invalidate)__asm__ volatile("dc ivac,%0"::"r"(at):"memory");
+  else __asm__ volatile("dc cvac,%0"::"r"(at):"memory");
+ }
+ __asm__ volatile("dsb sy":::"memory");
+}
+static bool read32(void *cookie,uint32_t va,uint32_t *value) {
+ auto *a=(X9CSFQueueAccess *)cookie;
+ if(!value||(va&3))return false;auto *ptr=(volatile uint32_t *)address(a,va,4);if(!ptr)return false;
+ /* Input fields are CPU-owned: invalidating them could discard an adjacent
+  * host write. Only MCU-owned output/metadata lines are invalidated. */
+ if(!host_input(a,va,4))cache((void *)ptr,4,true);
+ *value=*ptr;__asm__ volatile("dmb ishld":::"memory");return true;
+}
+static bool write32(void *cookie,uint32_t va,uint32_t value) {
+ auto *a=(X9CSFQueueAccess *)cookie;
+ if((va&3)||!host_input(a,va,4))return false;
+ auto *ptr=(volatile uint32_t *)address(a,va,4);if(!ptr)return false;
+ *ptr=value;return true;
+}
+static bool clean(void *cookie,uint32_t va,uint32_t bytes) {
+ auto *a=(X9CSFQueueAccess *)cookie;
+ if(!host_input(a,va,bytes))return false;void *ptr=address(a,va,bytes);if(!ptr)return false;
+ cache(ptr,bytes,false);return true;
+}
+static uint32_t reg(vm_offset_t base,unsigned offset) {
+ uint32_t v=*(volatile uint32_t *)(base+offset);__asm__ volatile("dmb oshld":::"memory");return v;
+}
+static bool healthy(void *cookie) {
+ auto *a=(X9CSFQueueAccess *)cookie;if(!a||!a->owned||!a->epoch||!a->gpu)return false;
+ uint32_t mmu=reg(a->gpu,0x2000),irq=reg(a->gpu,0x20),mcu=reg(a->gpu,0x704);
+ /* Exact pan168 CSF fault rules: upper MMU IRQ bits are not JM bus faults. */
+ return reg(a->gpu,0)==0xe8800010u&&mmu!=UINT32_MAX&&irq!=UINT32_MAX&&mcu!=UINT32_MAX&&
+  !(mmu&0xffffu)&&!(irq&3u)&&mcu!=3&&reg(a->gpu,0x700)==2;
+}
+static bool doorbell(void *cookie) {
+ auto *a=(X9CSFQueueAccess *)cookie;if(!healthy(a)||!a->kernel_doorbell)return false;
+ __asm__ volatile("dsb sy":::"memory");
+ *(volatile uint32_t *)a->kernel_doorbell=1;
+ __asm__ volatile("dsb sy":::"memory");return true;
+}
+static uint64_t now(void *) {uint64_t ns=0;absolutetime_to_nanoseconds(mach_absolute_time(),&ns);return ns;}
+static void yield(void *) {
+ static int event;uint64_t deadline;clock_interval_to_deadline(1,NSEC_PER_MSEC,&deadline);
+ (void)assert_wait_deadline(&event,THREAD_UNINT,deadline);thread_block(THREAD_CONTINUE_NULL);
+}
+}
+bool x9_csf_queue_access_init(X9CSFQueueAccess *out,const X9CSFSharedRange *ranges,uint32_t count,
+ const X9CSFGroupInterface *interface,vm_offset_t gpu,vm_offset_t db,uint64_t epoch) {
+ if(!out||!ranges||!interface||!count||count>64||!gpu||!db||!epoch||interface->stream_count!=3)return false;
+ for(unsigned i=0;i<count;i++) {
+  const auto &r=ranges[i];
+  if(!r.memory||!r.bytes||((r.gpu_va|r.bytes)&4095)||!r.memory->getBytesNoCopy()||
+     r.memory->getLength()<r.bytes||(uint64_t)r.gpu_va+r.bytes>1ULL<<32)return false;
+  for(unsigned j=0;j<i;j++)if(r.gpu_va<(uint64_t)ranges[j].gpu_va+ranges[j].bytes&&
+     ranges[j].gpu_va<(uint64_t)r.gpu_va+r.bytes)return false;
+ }
+ bzero(out,sizeof(*out));memcpy(out->ranges,ranges,count*sizeof(*ranges));out->range_count=count;
+ out->interface=*interface;out->gpu=gpu;out->kernel_doorbell=db;out->epoch=epoch;out->owned=true;
+ if(!healthy(out)||!address(out,interface->global_input,4096)||!address(out,interface->global_output,4096)||
+    !address(out,interface->group_input,0x70)||!address(out,interface->group_output,0x20))goto bad;
+ for(unsigned i=0;i<3;i++)if(!address(out,interface->streams[i].input,0x60)||!address(out,interface->streams[i].output,0xe0))goto bad;
+ return true;
+bad:out->owned=false;return false;
+}
+X9CSFQueueIO x9_csf_queue_access_io(X9CSFQueueAccess *a) {
+ return {a,read32,write32,clean,healthy,doorbell,now,yield};
+}
+void x9_csf_queue_access_invalidate(X9CSFQueueAccess *a) {if(a){a->owned=false;a->epoch=0;}}
diff --git a/iokit/Kernel/arm/X9CSFResident.h b/iokit/Kernel/arm/X9CSFResident.h
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/X9CSFResident.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+#include "X9CSFQueueAccess.h"
+/* Begin returns2 only for an owned resident MCU session. -1 means retain
+ * outer GPUEB refs,0 means clean skip/failure. Called under GPU owner lock. */
+extern "C" int sweet_x9_csf_resident_begin(vm_offset_t);
+/* End requires all firmware groups stopped/terminated and AS1 detached. */
+extern "C" int sweet_x9_csf_resident_end(void);
+extern "C" bool sweet_x9_csf_resident_caps(X9RenderCaps *);
+/* Reserved AS0 user I/O and suspend pages for one of eight physical slots.
+ * The caller must not change allocation ownership or use outside owner lock. */
+struct X9CSFResidentSlot {
+ X9CSFQueueAccess access;
+ uint32_t user_io,suspend;
+ bool borrowed;
+};
+extern "C" X9CSFResidentSlot *sweet_x9_csf_resident_slot(unsigned);
+extern "C" bool sweet_x9_csf_resident_release_slot(unsigned,uint64_t epoch);
diff --git a/iokit/Kernel/arm/SweetX9CSFResident.inc b/iokit/Kernel/arm/SweetX9CSFResident.inc
new file mode 100644
--- /dev/null
+++ b/iokit/Kernel/arm/SweetX9CSFResident.inc
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: MIT */
+/* Included inside the frozen SweetX9CSF namespace. Uses the proven parser,
+ * firmware image, PM delegation, AS0 setup and fresh PING helpers unchanged.
+ * Resident ownership is separate from per-request compute/desktop copies. */
+struct ResidentSession {
+ Plan image;
+ QueueProbe policy;
+ X9CSFResidentSlot slots[8];
+ X9RenderCaps caps;
+ vm_offset_t gpu,smmu,doorbell;
