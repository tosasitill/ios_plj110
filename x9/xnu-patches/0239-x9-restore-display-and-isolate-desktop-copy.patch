+/* Capture is called after a normal CPU present copy. All GPU waits occur
+ * on a detached worker; no GPU address ever names the live panel. */
+extern "C" int sweet_x9_gpu_desktop(void *);
+extern "C" kern_return_t thread_terminate(thread_t);
+struct X9DesktopCapture {
+ X9DesktopJob job;
+ IOBufferMemoryDescriptor *input,*output;
+};
+static bool desktop_capture_queued;
+static void desktop_capture_worker(void *arg,wait_result_t) {
+ X9DesktopCapture *capture=(X9DesktopCapture *)arg;
+ IOLog("X9 DESKTOP OFFSCREEN: worker started; waiting for provider lock outside display workloop\n");
+ IOLockLock(metal_service_lock);
+ int result=0;
+ if(!metal_service_disabled) {
+  IOLog("X9 DESKTOP OFFSCREEN: provider acquired; BEGIN private64x32 copy; live panel unmapped\n");
+  result=sweet_x9_gpu_desktop(&capture->job);
+  if(result<0)metal_service_disabled=true;
+ }
+ IOLog("X9 DESKTOP OFFSCREEN: worker result=%d computed=%u cleaned=%u; CPU display continues; no automatic retry\n",
+  result,capture->job.computed,capture->job.cleaned);
+ IOLockUnlock(metal_service_lock);
+ if(result>=0) {
+  capture->input->release();capture->output->release();IOFree(capture,sizeof(*capture));
+ }else IOLog("X9 DESKTOP OFFSCREEN: private capture and DMA/PM references retained; panel is not GPU-mapped\n");
+ (void)thread_terminate(current_thread());
+ thread_block(THREAD_CONTINUE_NULL);
+}
+extern "C" void sweet_x9_desktop_capture(const uint8_t *pixels,uint32_t stride,uint32_t width,uint32_t height) {
+ int mode=0;
+ if(!pixels||width<64||height<32||stride<(uint64_t)width*4||!metal_service_lock||
+    !PE_parse_boot_argn("x9_metal_system",&mode,sizeof(mode))||mode!=2)return;
+ /* Never wait for a compute client while holding the display workloop. */
+ if(!IOLockTryLock(metal_service_lock))return;
+ bool ready=!desktop_capture_queued&&!metal_service_disabled&&sweet_x9_metal_payload_ready&&
+  metal_root_passes>=4&&metal_mobile_passes>=4;
+ if(ready)desktop_capture_queued=true;
+ IOLockUnlock(metal_service_lock);
+ if(!ready)return;
+ X9DesktopCapture *capture=(X9DesktopCapture *)IOMallocZero(sizeof(X9DesktopCapture));
+ if(!capture){IOLog("X9 DESKTOP OFFSCREEN: capture allocation failed; CPU display continues\n");return;}
+ capture->input=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,kIODirectionInOut,host_page,host_page);
+ capture->output=IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,kIODirectionInOut,host_page,host_page);
+ if(!capture->input||!capture->output) {
+  if(capture->input)capture->input->release();if(capture->output)capture->output->release();
+  IOFree(capture,sizeof(*capture));IOLog("X9 DESKTOP OFFSCREEN: private buffer allocation failed; CPU display continues\n");return;
+ }
+ unsigned char *input=(unsigned char *)capture->input->getBytesNoCopy();
+ unsigned char *output=(unsigned char *)capture->output->getBytesNoCopy();
+ if(!input||!output) {
+  capture->input->release();capture->output->release();IOFree(capture,sizeof(*capture));return;
+ }
+ memset(input,0xa5,host_page);memset(output,0xa5,host_page);
+ unsigned ox=(width-64)/2,oy=(height-32)/2;
+ for(unsigned y=0;y<32;y++)memcpy(input+y*272,pixels+(uint64_t)(y+oy)*stride+ox*4,64*4);
+ X9DesktopJob &j=capture->job;
+ j.source=capture->input;j.destination=capture->output;j.source_cpu=input;j.destination_cpu=output;
+ j.source_stride=272;j.destination_stride=288;j.width=64;j.height=32;j.sequence=1;
+ thread_t worker=THREAD_NULL;
+ IOLog("X9 DESKTOP OFFSCREEN: actual desktop tile captured after CPU copy; root/mobile4+4 validated; queueing worker\n");
+ kern_return_t kr=kernel_thread_start(desktop_capture_worker,capture,&worker);
+ if(kr==KERN_SUCCESS)thread_deallocate(worker);
+ else {
+  capture->input->release();capture->output->release();IOFree(capture,sizeof(*capture));
+  IOLog("X9 DESKTOP OFFSCREEN: worker creation failed=%08x; CPU display continues\n",kr);
+ }
+}
