+/* Exact 32-bit scalar prefix from OPPO gpufreq/v2/include/gpufreq_v2.h.
+ * Firmware must populate this before any power request is allowed. */
+struct gpu_shared_prefix {
+ int32_t magic;
+ int32_t cur_oppidx_gpu;
+ int32_t cur_oppidx_stack;
+ int32_t opp_num_gpu;
+ int32_t opp_num_stack;
+ int32_t signed_opp_num_gpu;
+ int32_t signed_opp_num_stack;
+ int32_t power_count;
+ int32_t buck_count;
+ int32_t mtcmos_count;
+ int32_t cg_count;
+ int32_t active_count;
+ int32_t temperature;
+ int32_t temper_comp_norm_gpu;
+ int32_t temper_comp_high_gpu;
+ int32_t temper_comp_norm_stack;
+ int32_t temper_comp_high_stack;
+ uint32_t cur_fgpu;
+ uint32_t cur_fstack;
+ uint32_t cur_out_fgpu;
+ uint32_t cur_out_fstack;
+ uint32_t cur_fmeter_fgpu;
+ uint32_t cur_fmeter_fstack;
+ uint32_t cur_vgpu;
+ uint32_t cur_vstack;
+ uint32_t cur_vsram_gpu;
+ uint32_t cur_vsram_stack;
+ uint32_t cur_regulator_vgpu;
+ uint32_t cur_regulator_vstack;
+ uint32_t cur_regulator_vsram_gpu;
+ uint32_t cur_regulator_vsram_stack;
+ uint32_t cur_power_gpu;
+ uint32_t cur_power_stack;
+ uint32_t max_power_gpu;
+ uint32_t max_power_stack;
+ uint32_t min_power_gpu;
+ uint32_t min_power_stack;
+ uint32_t lkg_rt_info_gpu;
+ uint32_t lkg_rt_info_stack;
+ uint32_t lkg_rt_info_sram;
+ uint32_t lkg_ht_info_gpu;
+ uint32_t lkg_ht_info_stack;
+ uint32_t lkg_ht_info_sram;
+ uint32_t dac_low_vgpu;
+ uint32_t dac_low_vstack;
+ uint32_t cur_ceiling;
+ uint32_t cur_floor;
+ uint32_t cur_c_limiter;
+ uint32_t cur_f_limiter;
+ uint32_t cur_c_priority;
+ uint32_t cur_f_priority;
+ uint32_t power_control;
+ uint32_t active_sleep_control;
+ uint32_t dvfs_state;
+ uint32_t shader_present;
+};
+_Static_assert(sizeof(struct gpu_shared_prefix)==220,"GPUEB shared prefix ABI");
