@@ -0,0 +1,7 @@
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+struct sha256 {uint32_t h[8];uint64_t len;unsigned char buf[64];unsigned n;};
+void sha256_init(struct sha256 *);
+void sha256_update(struct sha256 *,const unsigned char *,size_t);
+void sha256_final(struct sha256 *,unsigned char [32]);
diff --git a/bsd/dev/x9_ufs/ufs_ro.c b/bsd/dev/x9_ufs/ufs_ro.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/x9_ufs/ufs_ro.c
@@ -0,0 +1,248 @@
+/* Legacy UFSHCI media-read-only engine plus bounded NOP/fDeviceInit. No link reset, device power
+ * command, PHY write, MCQ takeover, SMMU modification or disk write exists.
+ * X9 adapter must establish a real DMA aperture before x9u_open(...,1).
+ */
+#include "ufs_ro.h"
+
+static void clear(void *p,size_t n) { uint8_t *b=p;while(n--)*b++=0; }
+static void copy(void *d,const void *s,size_t n) { uint8_t *a=d;const uint8_t *b=s;while(n--)*a++=*b++; }
+static uint32_t le32(const uint8_t *p) { return p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24; }
+static uint32_t be32(const uint8_t *p) { return (uint32_t)p[0]<<24|(uint32_t)p[1]<<16|(uint32_t)p[2]<<8|p[3]; }
+static uint64_t be64(const uint8_t *p) { return (uint64_t)be32(p)<<32|be32(p+4); }
+static void put32(uint8_t *p,uint32_t n) {for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(n>>(8*i));}
+static void big32(uint8_t *p,uint32_t n) {for(unsigned i=0;i<4;i++)p[i]=(uint8_t)(n>>(24-8*i));}
+static void big64(uint8_t *p,uint64_t n) {big32(p,(uint32_t)(n>>32));big32(p+4,(uint32_t)n);}
+static uint32_t rd(struct x9u_host *h,unsigned o) {return h->io.read32(h->io.context,o);}
+static void wr(struct x9u_host *h,unsigned o,uint32_t v) {h->io.write32(h->io.context,o,v);}
+static int wait_mask(struct x9u_host *h,unsigned o,uint32_t mask,uint32_t want,uint32_t timeout)
+{
+ uint64_t start=h->io.now_us(h->io.context);
+ for(unsigned i=0;i<=timeout/10;i++) {
+  if((rd(h,o)&mask)==want)return 0;
+  if(h->io.now_us(h->io.context)-start>=timeout)break;
+  h->io.delay_us(h->io.context,10);
+ }
+ return X9U_TIMEOUT;
+}
+void x9u_snapshot(const struct x9u_io *io,struct x9u_snapshot *s)
+{
+#define R(field,offset) s->field=io->read32(io->context,offset)
+ R(cap,0);R(version,8);R(is,0x20);R(ie,0x24);R(hcs,0x30);R(hce,0x34);
+ R(list_lo,0x50);R(list_hi,0x54);R(doorbell,0x58);R(run,0x60);
+ R(task_doorbell,0x78);R(auto_h8,0x18);
+ /* MEM_CFG MCQ is defined only in UFSHCI4+; don't read vendor offsets on v2. */
+ s->memcfg=s->version>=0x400?io->read32(io->context,0x300):0;
+#undef R
+}
+int x9u_open(struct x9u_host *h,const struct x9u_io *io,void *dma,uint64_t pa,int verified)
+{
+ if(!h||!io||!io->read32||!io->write32||!io->sync||!io->now_us||!io->delay_us||
+    !dma||((uintptr_t)dma&1023)||(pa&1023)||pa>UINT64_MAX-X9U_DMA_SIZE)return X9U_ARGUMENT;
+ clear(h,sizeof(*h));h->io=*io;h->dma=dma;h->dma_pa=pa;
+ x9u_snapshot(io,&h->saved);
+ if(!verified)return X9U_DMA_UNVERIFIED;
+ if(h->saved.cap==0xffffffffU||!h->saved.version||h->saved.version==0xffffffffU||
+    !(h->saved.hce&1)||(h->saved.hcs&3)!=3)return X9U_NOT_READY;
+ if(h->saved.memcfg&1)return X9U_UNSUPPORTED;
+ if(h->saved.doorbell||h->saved.task_doorbell)return X9U_BUSY;
+ if(!(h->saved.cap&(1U<<24))&&(pa+X9U_DMA_SIZE-1)>UINT32_MAX)return X9U_BOUNDS;
+ /* Own only an idle legacy transfer list. Save/restore all changed registers. */
+ wr(h,0x24,0);wr(h,0x60,0);
+ if(wait_mask(h,0x60,1,0,10000)) {wr(h,0x24,h->saved.ie);return X9U_TIMEOUT;}
+ if(rd(h,0x58)||rd(h,0x78)) {wr(h,0x60,h->saved.run);wr(h,0x24,h->saved.ie);return X9U_BUSY;}
+ clear(dma,X9U_DMA_SIZE);io->sync(io->context,0,X9U_DMA_SIZE,0);
+ wr(h,0x50,(uint32_t)pa);wr(h,0x54,(uint32_t)(pa>>32));wr(h,0x60,1);
+ h->attached=1;
+ if(rd(h,0x50)!=(uint32_t)pa||rd(h,0x54)!=(uint32_t)(pa>>32)||
+    !(rd(h,0x60)&1)) {int e=x9u_close(h);return e?e:X9U_NOT_READY;}
+ return 0;
+}
+int x9u_close(struct x9u_host *h)
+{
+ if(!h||!h->attached)return 0;
+ /* Never hand memory to XNU while the controller might still DMA into it. */
+ if(rd(h,0x58)) {h->poisoned=1;return X9U_DMA_PENDING;}
+ wr(h,0x60,0);
+ if(wait_mask(h,0x60,1,0,10000)) {h->poisoned=1;return X9U_DMA_PENDING;}
+ wr(h,0x50,h->saved.list_lo);wr(h,0x54,h->saved.list_hi);
+ wr(h,0x60,h->saved.run);wr(h,0x24,h->saved.ie);h->attached=0;
+ return 0;
+}
+/* UFS transports CHECK CONDITION sense in the response UPIU itself.
+ * A later REQUEST SENSE may legitimately report NO SENSE after autosense. */
+static int decode_sense(struct x9u_host *h,const uint8_t *p,size_t n)
+{
+ if(!n)return 0;
+ unsigned format=p[0]&0x7f;
+ if((format==0x70||format==0x71)&&n>=14) {
+  h->sense_key=p[2]&15;h->sense_asc=p[12];h->sense_ascq=p[13];
+ }else if((format==0x72||format==0x73)&&n>=8) {
+  h->sense_key=p[1]&15;h->sense_asc=p[2];h->sense_ascq=p[3];
+ }else return 0;
+ h->sense_valid=1;return 1;
+}
+/* Private SCSI allowlist: media reads and no-data readiness only. */
+static int command(struct x9u_host *h,unsigned lun,const uint8_t cdb[16],unsigned cdb_len,uint32_t bytes)
+{
+ if(!h||!h->attached||h->poisoned||lun>=3||bytes>X9U_DATA_SIZE)return X9U_ARGUMENT;
+ if(!((cdb[0]==0&&cdb_len==6)||(cdb[0]==3&&cdb_len==6)||(cdb[0]==0x12&&cdb_len==6)||(cdb[0]==0x9e&&cdb[1]==0x10&&cdb_len==16)||
+      (cdb[0]==0x28&&cdb_len==10)||(cdb[0]==0x88&&cdb_len==16)))return X9U_UNSUPPORTED;
+ h->last_ocs=15;h->last_is=0;clear(h->last_response,sizeof(h->last_response));
+ h->failure_phase=0;h->sense_valid=0;h->sense_from_upiu=0;
+ h->sense_key=0;h->sense_asc=0;h->sense_ascq=0;
+ if(rd(h,0x58)||rd(h,0x78))return X9U_BUSY;
+ uint8_t *tr=h->dma,*cmd=h->dma+0x1000,*response=h->dma+0x1200,*prdt=h->dma+0x1400;
+ clear(tr,32);clear(cmd,0x410);
+ clear(h->dma+X9U_DATA_OFFSET,bytes);
+ if(!++h->tag)++h->tag;
+ cmd[0]=1;cmd[1]=bytes?0x40:0;cmd[2]=(uint8_t)lun;cmd[3]=h->tag;
+ big32(cmd+12,bytes);copy(cmd+16,cdb,cdb_len);
+ put32(tr,(1U<<28)|(bytes?(2U<<25):0)|(1U<<24));put32(tr+8,15);
+ uint64_t ucd=h->dma_pa+0x1000,data=h->dma_pa+X9U_DATA_OFFSET;
+ put32(tr+16,(uint32_t)ucd);put32(tr+20,(uint32_t)(ucd>>32));
+ put32(tr+24,(128U<<16)|128U);put32(tr+28,(256U<<16)|(bytes?1U:0));
+ put32(prdt,(uint32_t)data);put32(prdt+4,(uint32_t)(data>>32));put32(prdt+12,bytes?bytes-1:0);
+ h->io.sync(h->io.context,0,X9U_DMA_SIZE,0);
+ wr(h,0x58,1);
+ if(wait_mask(h,0x58,1,0,X9U_COMMAND_TIMEOUT_US)) {
+  /* UTRLCLR is inverse: zero clears the chosen slot. No new command follows. */
+  wr(h,0x5c,~1U);h->poisoned=1;h->failure_phase=1;
+  if(wait_mask(h,0x58,1,0,10000))return X9U_DMA_PENDING;
+  return X9U_TIMEOUT;
+ }
+ h->io.sync(h->io.context,0,X9U_DMA_SIZE,1);
+ h->last_is=rd(h,0x20);h->last_ocs=le32(tr+8)&255;copy(h->last_response,response,sizeof(h->last_response));
+ /* Acknowledge only UTR completion generated by this request, not other errors. */
+ if(h->last_is&1)wr(h,0x20,1);
+ if(h->last_ocs){h->failure_phase=2;return X9U_RESPONSE;}
+ /* Target failure (Response=1) accompanies legitimate CHECK CONDITION.
+  * Validate framing separately from SCSI status, as Linux does. Reserved
+  * response values and target-failure + GOOD are never successful reads. */
+ if(response[0]!=0x21||response[2]!=lun||response[3]!=h->tag||
+    response[6]>1||(response[6]&&!response[7])) {
+  h->failure_phase=3;return X9U_RESPONSE;
+ }
+ if(response[7]) {
+  h->failure_phase=4;
+  if(response[7]==2) {
+   unsigned segment=(unsigned)response[10]<<8|response[11];
+   unsigned length=(unsigned)response[32]<<8|response[33];
+   if(length) {
+    if(length>18||segment<length+2||segment>480){h->failure_phase=3;return X9U_RESPONSE;}
+    h->sense_from_upiu=decode_sense(h,response+34,length);
+    if(!h->sense_from_upiu){h->failure_phase=3;return X9U_RESPONSE;}
+   }
+  }
+  return X9U_RESPONSE;
+ }
+ uint32_t residual=be32(response+12);
+ /* REQUEST SENSE can return an 8-byte descriptor instead of 18 allocated
+  * bytes. Never accept short data for capacity, GPT or filesystem reads. */
+ if((response[1]&0x40)||((response[1]&0x20)||residual)) {
+  if((response[1]&0x40)||cdb[0]!=3||!(response[1]&0x20)||!residual||residual>bytes||bytes-residual<4) {
+   h->failure_phase=5;return X9U_RESPONSE;
+  }
+ }
+ return 0;
+}
+/* Only NOP and fDeviceInit SET/READ_FLAG are supported: no arbitrary query,
+ * descriptor write, persistent configuration, crypto keyslot or media WRITE. */
+static int management(struct x9u_host *h,unsigned opcode,unsigned *flag)
+{
+ if(!h||!h->attached||h->poisoned||(opcode!=0&&opcode!=5&&opcode!=6))return X9U_ARGUMENT;
+ if(rd(h,0x58)||rd(h,0x78))return X9U_BUSY;
+ uint8_t *tr=h->dma,*cmd=tr+0x1000,*response=tr+0x1200;
+ clear(tr,32);clear(cmd,0x410);
+ if(!++h->tag)++h->tag;
+ cmd[0]=opcode?0x16:0;cmd[3]=h->tag;
+ if(opcode){cmd[5]=opcode==6?0x81:1;cmd[12]=(uint8_t)opcode;cmd[13]=1;}
+ put32(tr,(1U<<28)|(1U<<24));put32(tr+8,15);
+ uint64_t ucd=h->dma_pa+0x1000;
+ put32(tr+16,(uint32_t)ucd);put32(tr+20,(uint32_t)(ucd>>32));
+ put32(tr+24,(128U<<16)|128U);put32(tr+28,256U<<16);
+ h->io.sync(h->io.context,0,X9U_DMA_SIZE,0);wr(h,0x58,1);
+ if(wait_mask(h,0x58,1,0,X9U_COMMAND_TIMEOUT_US)) {
+  wr(h,0x5c,~1U);h->poisoned=1;
+  if(wait_mask(h,0x58,1,0,10000))return X9U_DMA_PENDING;
+  return X9U_TIMEOUT;
+ }
+ h->io.sync(h->io.context,0,X9U_DMA_SIZE,1);
+ h->last_is=rd(h,0x20);h->last_ocs=le32(tr+8)&255;copy(h->last_response,response,sizeof(h->last_response));
+ if(h->last_is&1)wr(h,0x20,1);
+ if(h->last_ocs||response[0]!=(opcode?0x36:0x20)||response[2]||response[3]!=h->tag||
+    response[6]||response[7]||response[10]||response[11])return X9U_RESPONSE;
+ if(opcode&&(response[12]!=opcode||response[13]!=1||response[14]||response[15]))return X9U_RESPONSE;
+ if(flag)*flag=be32(response+20)&1;
+ return 0;
+}
+int x9u_device_init(struct x9u_host *h,unsigned *stage)
+{
+ if(!stage)return X9U_ARGUMENT;
+ *stage=1;int error=management(h,0,0);if(error)return error;
+ *stage=2;error=management(h,6,0);if(error)return error;
+ *stage=3;uint64_t start=h->io.now_us(h->io.context);
+ for(unsigned tries=0;tries<1000;tries++) {
+  unsigned flag=1;error=management(h,5,&flag);if(error)return error;
+  if(!flag){*stage=4;return 0;}
+  if(h->io.now_us(h->io.context)-start>=1000000)break;
+  h->io.delay_us(h->io.context,1000);
+ }
+ return X9U_TIMEOUT;
+}
+int x9u_inquiry(struct x9u_host *h,unsigned lun,void *out,size_t size)
+{
+ if(!out||size<36)return X9U_ARGUMENT;
+ uint8_t cdb[16]={0x12,0,0,0,36};int e=command(h,lun,cdb,6,36);
+ if(!e)copy(out,h->dma+X9U_DATA_OFFSET,36);return e;
+}
+int x9u_lun_ready(struct x9u_host *h,unsigned lun)
+{
+ if(!h||lun>=3)return X9U_ARGUMENT;
+ h->ready_attempts=0;h->sense_requests=0;h->sense_request_error=0;
+ h->ready_unit_attentions=0;h->ready_last_category=0;h->ready_last_asc=0;h->ready_last_ascq=0;
+ clear(h->tur_response,sizeof(h->tur_response));h->tur_failure_phase=0;h->tur_ocs=0;
+ for(unsigned attempt=0;attempt<3;attempt++) {
+  h->ready_attempts=attempt+1;
+  uint8_t cdb[16]={0};int error=command(h,lun,cdb,6,0);if(!error)return 0;
+  copy(h->tur_response,h->last_response,sizeof(h->tur_response));
+  h->tur_failure_phase=h->failure_phase;h->tur_ocs=h->last_ocs;
+  if(error!=X9U_RESPONSE||h->failure_phase!=4)return error;
+  unsigned status=h->last_response[7];
+  if(status==8||status==0x28){h->io.delay_us(h->io.context,100000);continue;}
+  if(status!=2)return error;
+  if(!h->sense_valid) {
+   cdb[0]=3;cdb[4]=18;h->sense_requests++;
+   error=command(h,lun,cdb,6,18);h->sense_request_error=error;if(error)return error;
+   uint32_t residual=be32(h->last_response+12);
+   if(residual>18||!decode_sense(h,h->dma+X9U_DATA_OFFSET,18-residual))return X9U_RESPONSE;
+  }
+  h->ready_last_category=h->sense_key;h->ready_last_asc=h->sense_asc;h->ready_last_ascq=h->sense_ascq;
+  if(h->sense_key==6)h->ready_unit_attentions++;
+  if(h->sense_key!=6&&h->sense_key!=0&&!(h->sense_key==2&&h->sense_asc==4))return X9U_RESPONSE;
+  /* NO SENSE is not readiness: require a later TUR with GOOD status. */
+  h->io.delay_us(h->io.context,100000);
+ }
+ return X9U_NOT_READY;
+}
+int x9u_capacity(struct x9u_host *h,unsigned lun)
+{
+ if(!h||lun>=3)return X9U_ARGUMENT;
+ uint8_t cdb[16]={0x9e,0x10};big32(cdb+10,32);
+ int e=command(h,lun,cdb,16,32);if(e)return e;
+ const uint8_t *data=h->dma+X9U_DATA_OFFSET;uint64_t last=be64(data);uint32_t block=be32(data+8);
+ if(last==UINT64_MAX||!last||block<512||block>4096||(block&(block-1)))return X9U_GEOMETRY;
+ h->blocks[lun]=last+1;h->block_size[lun]=block;return 0;
+}
+int x9u_read(struct x9u_host *h,unsigned lun,uint64_t lba,uint32_t count,void *out)
+{
+ if(!h||lun>=3||!out||!count||!h->block_size[lun]||!h->blocks[lun]||
+    lba>=h->blocks[lun]||count>h->blocks[lun]-lba||
+    count>X9U_DATA_SIZE/h->block_size[lun])return X9U_BOUNDS;
+ uint8_t cdb[16]={0};unsigned length;
+ if(lba<=UINT32_MAX && count<=UINT16_MAX && count-1<=UINT32_MAX-lba) {
+  cdb[0]=0x28;big32(cdb+2,(uint32_t)lba);cdb[7]=(uint8_t)(count>>8);cdb[8]=(uint8_t)count;length=10;
+ } else {cdb[0]=0x88;big64(cdb+2,lba);big32(cdb+10,count);length=16;}
+ uint32_t bytes=count*h->block_size[lun];int e=command(h,lun,cdb,length,bytes);
+ if(!e && out!=h->dma+X9U_DATA_OFFSET)copy(out,h->dma+X9U_DATA_OFFSET,bytes);
+ return e;
+}
diff --git a/bsd/dev/x9_ufs/ufs_ro.h b/bsd/dev/x9_ufs/ufs_ro.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/x9_ufs/ufs_ro.h
@@ -0,0 +1,60 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#define X9U_DMA_SIZE 0x14000U
+#define X9U_DATA_OFFSET 0x4000U
+#define X9U_DATA_SIZE 0x10000U
+#define X9U_COMMAND_TIMEOUT_US 1000000U
+
+enum x9u_error {
+ X9U_OK=0, X9U_ARGUMENT=-1, X9U_NOT_READY=-2, X9U_BUSY=-3,
+ X9U_DMA_UNVERIFIED=-4, X9U_UNSUPPORTED=-5, X9U_TIMEOUT=-6,
+ X9U_RESPONSE=-7, X9U_GEOMETRY=-8, X9U_CRC=-9, X9U_NOT_FOUND=-10,
+ X9U_DMA_PENDING=-11, X9U_BOUNDS=-12
+};
+/* DMA sync must include required barriers/cache maintenance. No storage-write
+ * or arbitrary CDB interface is exported. All polling is bounded. */
+struct x9u_io {
+ void *context;
+ uint32_t (*read32)(void *,unsigned);
+ void (*write32)(void *,unsigned,uint32_t);
+ void (*sync)(void *,unsigned,size_t,int); /* int=0 CPU->DMA, 1 DMA->CPU */
+ uint64_t (*now_us)(void *);
+ void (*delay_us)(void *,unsigned);
+};
+struct x9u_snapshot {
+ uint32_t cap,version,is,ie,hcs,hce,list_lo,list_hi,doorbell,run;
+ uint32_t task_doorbell,auto_h8,memcfg;
+};
+struct x9u_host {
+ struct x9u_io io;
+ uint8_t *dma;
+ uint64_t dma_pa;
+ struct x9u_snapshot saved;
+ uint64_t blocks[3];
+ uint32_t block_size[3];
+ uint32_t last_ocs,last_is;
+ uint8_t last_response[64],tur_response[64],tag;
+ unsigned attached,poisoned;
+ unsigned sense_key,sense_asc,sense_ascq,sense_valid,sense_from_upiu;
+ unsigned failure_phase,tur_failure_phase,tur_ocs,ready_attempts,sense_requests;
+ int sense_request_error;
+ unsigned ready_unit_attentions,ready_last_category,ready_last_asc,ready_last_ascq;
+};
+struct x9u_partition { uint64_t first,count; uint8_t guid[16]; };
+struct x9u_extent { uint64_t file,part,count; }; /* 4KiB blocks, partition-relative */
+
+void x9u_snapshot(const struct x9u_io *,struct x9u_snapshot *);
+int x9u_open(struct x9u_host *,const struct x9u_io *,void *,uint64_t,int);
+int x9u_close(struct x9u_host *);
+int x9u_device_init(struct x9u_host *,unsigned *stage);
+int x9u_inquiry(struct x9u_host *,unsigned,void *,size_t);
+int x9u_lun_ready(struct x9u_host *,unsigned);
+int x9u_capacity(struct x9u_host *,unsigned);
+int x9u_read(struct x9u_host *,unsigned,uint64_t,uint32_t,void *);
+int x9u_gpt_find(struct x9u_host *,unsigned,const char *,struct x9u_partition *);
+uint32_t x9u_crc32(uint32_t,const void *,size_t);
+int x9u_extent_validate(const struct x9u_extent *,size_t,uint64_t,uint64_t);
+int x9u_image_read(struct x9u_host *,unsigned,const struct x9u_partition *,
+                   const struct x9u_extent *,size_t,uint64_t,uint64_t,void *,size_t);
diff --git a/bsd/dev/x9_ufs/ufs_volume.c b/bsd/dev/x9_ufs/ufs_volume.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/x9_ufs/ufs_volume.c
@@ -0,0 +1,121 @@
+/* CRC-validated GPT and a read-only pinned-file virtual block layer.
+ * These helpers do not parse F2FS, bypass Android encryption, allocate files,
+ * expose arbitrary disk writes, or assume an extent manifest is current.
+ */
+#include "ufs_ro.h"
+
+static uint32_t le32(const uint8_t *p) {return p[0]|(uint32_t)p[1]<<8|(uint32_t)p[2]<<16|(uint32_t)p[3]<<24;}
+static uint64_t le64(const uint8_t *p) {return le32(p)|(uint64_t)le32(p+4)<<32;}
+static int equal(const void *a,const void *b,size_t n) {const uint8_t *p=a,*q=b;while(n--)if(*p++!=*q++)return 0;return 1;}
+static void copy(void *a,const void *b,size_t n) {uint8_t *p=a;const uint8_t *q=b;while(n--)*p++=*q++;}
+uint32_t x9u_crc32(uint32_t crc,const void *data,size_t size)
+{
+ const uint8_t *p=data;crc=~crc;
+ while(size--) {crc^=*p++;for(unsigned i=0;i<8;i++)crc=(crc>>1)^((0U-(crc&1))&0xedb88320U);}
+ return ~crc;
+}
+static int name_equal(const uint8_t *p,const char *name)
+{
+ for(unsigned i=0;i<36;i++) {
+  if(!name[i])return !p[2*i]&&!p[2*i+1];
+  if((uint8_t)name[i]!=p[2*i]||p[2*i+1])return 0;
+ }
+ return name[36]==0;
+}
+int x9u_gpt_find(struct x9u_host *h,unsigned lun,const char *name,struct x9u_partition *out)
+{
+ if(!h||lun>=3||!name||!out)return X9U_ARGUMENT;
+ uint32_t block=h->block_size[lun];
+ if(!block||h->blocks[lun]<3)return X9U_GEOMETRY;
+ uint8_t *buf=h->dma+X9U_DATA_OFFSET;
+ int e=x9u_read(h,lun,1,1,buf);if(e)return e;
+ if(!equal(buf,"EFI PART",8)||le32(buf+8)!=0x10000)return X9U_GEOMETRY;
+ uint32_t size=le32(buf+12),saved=le32(buf+16);
+ if(size<92||size>block||le32(buf+20)||le64(buf+24)!=1||le64(buf+32)>=h->blocks[lun])return X9U_GEOMETRY;
+ uint32_t crc=x9u_crc32(0,buf,16);uint32_t zero=0;
+ crc=x9u_crc32(crc,&zero,4);crc=x9u_crc32(crc,buf+20,size-20);
+ if(crc!=saved)return X9U_CRC;
+ uint64_t first=le64(buf+40),last=le64(buf+48),table=le64(buf+72);
+ uint32_t count=le32(buf+80),entry=le32(buf+84),table_crc=le32(buf+88);
+ if(first>last||first<2||last>=h->blocks[lun]||table<2||!count||count>4096||
+    entry<128||entry>block||(entry&(entry-1))||block%entry)return X9U_GEOMETRY;
+ uint64_t bytes=(uint64_t)count*entry,blocks=(bytes+block-1)/block;
+ if(table>=first||blocks>first-table||table>=h->blocks[lun]||blocks>h->blocks[lun]-table)return X9U_BOUNDS;
+ static struct {uint64_t first,last;} ranges[4096];
+ struct x9u_partition found={0};unsigned matches=0,used_ranges=0;uint64_t consumed=0;crc=0;
+ while(consumed<bytes) {
+  uint64_t remaining=bytes-consumed;
+  uint32_t take=remaining>X9U_DATA_SIZE?X9U_DATA_SIZE:(uint32_t)remaining;
+  uint32_t nblocks=(take+block-1)/block;
+  e=x9u_read(h,lun,table+consumed/block,nblocks,buf);if(e)return e;
+  crc=x9u_crc32(crc,buf,take);
+  for(uint32_t offset=0;offset<take;offset+=entry) {
+   const uint8_t *p=buf+offset;unsigned used=0;for(unsigned i=0;i<16;i++)used|=p[i];
+   if(!used)continue;
+   uint64_t a=le64(p+32),b=le64(p+40);
+   if(a<first||a>b||b>last)return X9U_BOUNDS;
+   ranges[used_ranges].first=a;ranges[used_ranges].last=b;used_ranges++;
+   if(name_equal(p+56,name)) {
+    found.first=a;found.count=b-a+1;copy(found.guid,p+16,16);matches++;
+   }
+  }
+  consumed+=take;
+ }
+ if(crc!=table_crc)return X9U_CRC;
+ for(size_t gap=used_ranges/2;gap;gap/=2)for(size_t i=gap;i<used_ranges;i++) {
+  uint64_t a=ranges[i].first,b=ranges[i].last;size_t j=i;
+  while(j>=gap&&ranges[j-gap].first>a) {ranges[j]=ranges[j-gap];j-=gap;}
+  ranges[j].first=a;ranges[j].last=b;
+ }
+ for(unsigned i=1;i<used_ranges;i++)if(ranges[i-1].last>=ranges[i].first)return X9U_BOUNDS;
+ if(matches!=1)return X9U_NOT_FOUND;
+ *out=found;return 0;
+}
+int x9u_extent_validate(const struct x9u_extent *map,size_t n,uint64_t blocks,uint64_t partition_blocks)
+{
+ if(!map||!n||n>16384||!blocks||!partition_blocks)return X9U_ARGUMENT;
+ /* The controller API is serialized; bounded BSS avoids a 32KiB stack array.
+  * Sort an index, retaining logical file order for binary read lookups. */
+ static uint16_t physical_order[16384];
+ uint64_t pos=0;
+ for(size_t i=0;i<n;i++) {
+  if(map[i].file!=pos||!map[i].count||pos>blocks||map[i].count>blocks-pos||
+     map[i].part>=partition_blocks||map[i].count>partition_blocks-map[i].part)return X9U_BOUNDS;
+  physical_order[i]=(uint16_t)i;pos+=map[i].count;
+ }
+ if(pos!=blocks)return X9U_BOUNDS;
+ for(size_t gap=n/2;gap;gap/=2)for(size_t i=gap;i<n;i++) {
+  uint16_t value=physical_order[i];size_t j=i;
+  while(j>=gap&&map[physical_order[j-gap]].part>map[value].part) {
+   physical_order[j]=physical_order[j-gap];j-=gap;
+  }
+  physical_order[j]=value;
+ }
+ for(size_t i=1;i<n;i++) {
+  const struct x9u_extent *a=&map[physical_order[i-1]],*b=&map[physical_order[i]];
+  if(a->part+a->count>b->part)return X9U_BOUNDS;
+ }
+ return 0;
+}
+int x9u_image_read(struct x9u_host *h,unsigned lun,const struct x9u_partition *partition,
+                   const struct x9u_extent *map,size_t n,uint64_t blocks,uint64_t offset,void *out,size_t length)
+{
+ if(!h||lun>=3||!partition||!out||h->block_size[lun]!=4096||blocks>UINT64_MAX/4096||
+    partition->first>=h->blocks[lun]||partition->count>h->blocks[lun]-partition->first||
+    offset>blocks*4096||length>blocks*4096-offset)return X9U_BOUNDS;
+ int e=x9u_extent_validate(map,n,blocks,partition->count);if(e)return e;
+ uint8_t *dst=out;
+ while(length) {
+  uint64_t logical=offset/4096;size_t lo=0,hi=n;
+  while(lo<hi) {size_t mid=lo+(hi-lo)/2;if(map[mid].file<=logical)lo=mid+1;else hi=mid;}
+  if(!lo)return X9U_BOUNDS;
+  const struct x9u_extent *item=&map[lo-1];uint64_t delta=logical-item->file;
+  if(delta>=item->count)return X9U_BOUNDS;
+  uint32_t skip=(uint32_t)(offset%4096);uint64_t available=(item->count-delta)*4096-skip;
+  size_t take=length;if(take>X9U_DATA_SIZE-skip)take=X9U_DATA_SIZE-skip;if(take>available)take=(size_t)available;
+  uint32_t count=(uint32_t)((skip+take+4095)/4096);
+  e=x9u_read(h,lun,partition->first+item->part+delta,count,h->dma+X9U_DATA_OFFSET);if(e)return e;
+  copy(dst,h->dma+X9U_DATA_OFFSET+skip,take);dst+=take;offset+=take;length-=take;
+ }
+ return 0;
+}
