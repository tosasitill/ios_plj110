diff --git a/iokit/Kernel/arm/SweetBoard.h b/iokit/Kernel/arm/SweetBoard.h
--- a/iokit/Kernel/arm/SweetBoard.h
+++ b/iokit/Kernel/arm/SweetBoard.h
@@ -1,55 +1,29 @@
 /*
- * Which board this SWEET kernel runs on. One kernel serves the Qualcomm
- * boards (sweet, topaz) and the Infinix X676C (MediaTek MT6789). Drivers
- * that poke Qualcomm MMIO at fixed physical addresses (MDP/DSI, cpufreq-hw,
- * GENI I2C, the modem) must stay off on the X676C: those addresses belong
- * to unrelated MediaTek blocks there. The ADT root compatible decides
- * (x676c/tools/mkadt.py puts 'infinix,x676c' in it); it is read straight
- * from the flattened ADT, like bsd/dev/sweet_ufs.c does, so it works before
- * and independently of the IORegistry device-tree plane.
+ * The boot CPU selects the board from the bounded ADT compatible list after
+ * PE_init_platform. Keep MT6789 and MT6993 distinct: neither may enter the
+ * Qualcomm fixed-MMIO paths, and X9 must never run an X676C power sequence.
  */
 #ifndef _IOKIT_ARM_SWEETBOARD_H
 #define _IOKIT_ARM_SWEETBOARD_H
 
-#include <pexpert/device_tree.h>
-
-/* NUL-separated string list `list` of `size` bytes contains `want`. */
-static inline bool
-sweet_strlist_has(const char *list, unsigned int size, const char *want)
-{
-	unsigned int i = 0;
-
-	while (i < size) {
-		unsigned int j = 0;
-		while (i + j < size && want[j] != '\0' && list[i + j] == want[j]) {
-			j++;
-		}
-		if (want[j] == '\0' && (i + j == size || list[i + j] == '\0')) {
-			return true;
-		}
-		while (i < size && list[i] != '\0') {
-			i++;
-		}
-		i++;
-	}
-	return false;
-}
+#include <arm64/sweet_early.h>
 
 static inline bool
 sweet_board_x676c(void)
 {
-	static int cached = -1;
+	return sweet_early_is_x676c() != 0;
+}
 
-	if (cached < 0) {
-		DTEntry root;
-		void const *prop;
-		unsigned int size;
+static inline bool
+sweet_board_x9(void)
+{
+	return sweet_early_is_x9() != 0;
+}
 
-		cached = SecureDTLookupEntry(NULL, "/", &root) == kSuccess &&
-		    SecureDTGetProperty(root, "compatible", &prop, &size) == kSuccess &&
-		    sweet_strlist_has((const char *)prop, size, "infinix,x676c");
-	}
-	return cached == 1;
+static inline bool
+sweet_board_qcom(void)
+{
+	return !sweet_board_x676c() && !sweet_board_x9();
 }
 
 #endif /* _IOKIT_ARM_SWEETBOARD_H */
