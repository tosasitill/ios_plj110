+static int
+sweet_compatible_has(const char *list, unsigned int size, const char *want)
+{
+	unsigned int i = 0;
+	while (i < size) {
+		unsigned int end = i;
+		while (end < size && list[end]) {
+			end++;
+		}
+		if (end == size) {
+			return 0;
+		}
+		unsigned int j = 0;
+		while (i + j < end && want[j] && list[i + j] == want[j]) {
+			j++;
+		}
+		if (i + j == end && !want[j]) {
+			return 1;
+		}
+		i = end + 1;
+	}
+	return 0;
+}
