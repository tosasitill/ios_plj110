+	uint64_t pa = video->v_baseAddr, stride = video->v_rowBytes;
+	if ((video->v_depth & kBootVideoDepthMask) != 32 ||
+	    !sweet_fb_layout_valid(pa, UINT64_MAX, video->v_width,
+	    video->v_height, stride)) {
