diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -1,94 +1,280 @@
 /*
- * Bootstrap console. No allocation, locks, ADT parsing or per-CPU state:
- * panic() can reach this before a current thread exists.
- * start.s maps the splash framebuffer and pstore blocks VA=PA as Device
- * memory. arm_vm_init installs reserved kernel VA aliases before removing
- * TTBR0; retain this console until the normal framebuffer serial console is
- * ready. The pstore mirror stays for the whole boot (see sweet_pstore_putc).
+ * Bootstrap console, selected only after PE_init_platform initializes the ADT.
+ * start.s maps the boot video block as Device memory; arm_vm_init retains that
+ * block at a reserved kernel VA. No framebuffer or persistent-RAM pointer is
+ * usable before explicit initialization. A small local buffer retains the
+ * first messages until an optional console record can be mapped.
  */
 #include <arm64/sweet_early.h>
 
 #if defined(SWEET)
 #include <stdint.h>
 #include <kern/misc_protos.h>
-
-static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)SWEET_EARLY_FB_PA;
-
-/*
- * x676c: everything the consoles print is also appended to the ramoops
- * console zone, behind the shim's own log. Same ring discipline as Linux
- * persistent_ram: header {sig, start = next write offset, size = valid
- * bytes}, data after it. The next Android boot exposes it as
- * /sys/fs/pstore/console-ramoops-0, which survives any hang or panic here.
- */
-#define PSTORE_SIG 0x43474244u          /* PERSISTENT_RAM_SIG, "DBGC" */
+#include <machine/machine_routines.h>
+#include <mach/vm_param.h>
+#include <pexpert/arm64/boot.h>
+#include <pexpert/device_tree.h>
+
