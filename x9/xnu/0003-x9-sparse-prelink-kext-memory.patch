 #if VM_MAPPED_KEXTS
 					kext_free(new_endofkext, (endofkext - new_endofkext));
 #else
-					ml_static_mfree(new_endofkext, (endofkext - new_endofkext));
+					if (!x9_sparse_prelink_memory(new_endofkext)) {
