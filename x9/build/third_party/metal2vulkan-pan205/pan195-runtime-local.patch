+/// A deliberately closed proof over the canonical entry (one defined function).
+/// No loads, stores, atomics, pointer traffic, texture access, unresolved calls,
+/// group operations or volatile effects are admitted. The returned stage outputs
+/// are invocation-private values. An unknown opcode keeps the barrier intact.
+fn independent_vertex(body:&crate::air::ir::Body)->bool {
+    body.insts.values().all(|inst|match &inst.kind {
+        InstKind::BinOp{..}|InstKind::FNeg{..}|InstKind::Cast{..}|
+        InstKind::ICmp{..}|InstKind::FCmp{..}|InstKind::Select{..}|
+        InstKind::Freeze(..)|InstKind::ExtractElement{..}|InstKind::InsertElement{..}|
+        InstKind::ShuffleVector{..}|InstKind::ExtractValue{..}|InstKind::InsertValue{..}|
+        InstKind::Phi{..}|InstKind::Ret(..)|InstKind::Br{..}|InstKind::CondBr{..}|
+        InstKind::Switch{..}|InstKind::Unreachable=>true,
+        InstKind::Call(call)=>matches!(&call.callee,Callee::Air{op:
+            AirIntrinsic::Math(..)|AirIntrinsic::Convert(..)|AirIntrinsic::Pack(..)|
+            AirIntrinsic::BoolReduce(..)|AirIntrinsic::Sync(Sync::Barrier{scope:ThreadScope::Simdgroup,..}),..}),
+        _=>false,
