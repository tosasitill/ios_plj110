+
+impl VertexCaptureWork {
+    pub(crate) fn new(
+        core: &EncoderCore,
+        draw: DrawCall,
+        capture: &metal2vulkan::pipeline::VertexCapture,
+        module: &metal2vulkan::pipeline::StageModule,
+    ) -> Result<Self, Error> {
