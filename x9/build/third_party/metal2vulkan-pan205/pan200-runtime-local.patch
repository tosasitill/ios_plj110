+fn capture_word(fb: &mut FunctionBuilder<'_>, buffer: GlobalId, index: u32) -> BResult<SValue> {
+    let p = fb.module().global_value(buffer)?;
+    let zero = crate::memory::leaf::k32(fb, 0)?;
+    let index = crate::memory::leaf::k32(fb, index)?;
+    let p = fb.access_chain(p, &[zero, index])?;
+    fb.load(p, MemAccess::default())
+}
+
+fn capture_ids(
+    cx: &mut EmitCx<'_>,
+    fb: &mut FunctionBuilder<'_>,
+) -> BResult<(GlobalId, SValue, SValue)> {
+    let d = &cx.decl.families.stage_io;
+    let (Some(buffer), Some(invocation)) = (d.capture_buffer, d.capture_invocation) else {
+        return Err(cx.fail("capture declaration missing"));
+    };
+    let p = fb.module().global_value(invocation)?;
+    let id = fb.load(p, MemAccess::default())?;
+    let vertex = fb.composite_extract(id, &[0])?;
+    let instance = fb.composite_extract(id, &[1])?;
+    Ok((buffer, vertex, instance))
+}
+
+fn capture_entry(cx: &mut EmitCx<'_>, fb: &mut FunctionBuilder<'_>) -> BResult<()> {
+    if cx.plan.families.stage_io.capture.is_none() {
+        return Ok(());
+    }
+    let (buffer, vertex, instance) = capture_ids(cx, fb)?;
+    let start = capture_word(fb, buffer, 1)?;
+    let base = capture_word(fb, buffer, 2)?;
+    let vertex = fb.binary(BinOp::IAdd, vertex, start)?;
+    let instance = fb.binary(BinOp::IAdd, instance, base)?;
+    use crate::spv::BuiltIn as B;
+    for (object, global) in cx
+        .plan
+        .families
+        .stage_io
+        .objects
+        .iter()
+        .zip(&cx.decl.families.stage_io.globals)
+    {
+        let IoObject::Builtin {
+            builtin,
+            dir: IoDir::Input,
+            ..
+        } = object
+        else {
+            continue;
+        };
+        let value = match builtin {
+            B::VertexIndex => vertex,
+            B::InstanceIndex => instance,
+            B::BaseVertex => start,
+            B::BaseInstance => base,
+            _ => return Err(BuildError::Type(TypeRule::VectorShape)),
+        };
+        let ptr = fb.module().global_value(*global)?;
+        fb.store(ptr, value, MemAccess::default())?;
+    }
+    Ok(())
+}
+
+fn capture_return(cx: &mut EmitCx<'_>, fb: &mut FunctionBuilder<'_>) -> BResult<()> {
+    let Some(capture) = cx.plan.families.stage_io.capture.clone() else {
+        return Ok(());
+    };
+    let (buffer, vertex, instance) = capture_ids(cx, fb)?;
+    let count = capture_word(fb, buffer, 0)?;
+    let row = fb.binary(BinOp::IMul, instance, count)?;
+    let ordinal = fb.binary(BinOp::IAdd, row, vertex)?;
+    let stride = crate::memory::leaf::k32(fb, capture.stride)?;
+    let offset = fb.binary(BinOp::IMul, ordinal, stride)?;
+    let header = crate::memory::leaf::k32(fb, 4)?;
+    let record = fb.binary(BinOp::IAdd, offset, header)?;
+    let globals: Vec<_> = capture
+        .indices
+        .iter()
+        .map(|&i| cx.decl.families.stage_io.globals[i])
+        .collect();
+    crate::pipeline::link::vertex_capture::store_record(
+        fb,
+        buffer,
+        record,
+        &capture.fields,
+        &globals,
+    )
+}
