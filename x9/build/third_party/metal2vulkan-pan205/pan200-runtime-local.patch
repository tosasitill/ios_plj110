+        && samples <= 32
+        && limits.standard_sample_locations == ash::vk::TRUE
+        && limits.sub_pixel_precision_bits >= 4
+        && device
+            .compile_device()
+            .profile()
+            .enabled()
+            .features
+            .contains(&VkFeature::SampleRateShading)
