+        let limits = &description.limits;
+        let flags: vk::PipelineShaderStageCreateFlags = module.stage_flags.into();
+        let full = flags.contains(vk::PipelineShaderStageCreateFlags::REQUIRE_FULL_SUBGROUPS);
+        let subgroup_size = module.required_subgroup_size.unwrap_or_else(|| {
+            if flags.contains(vk::PipelineShaderStageCreateFlags::ALLOW_VARYING_SUBGROUP_SIZE) {
+                description.subgroup.max_size
+            } else {
+                description.subgroup.size
+            }
+        });
+        if module.stage != metal2vulkan::vk::ShaderStage::COMPUTE
+            || capture.local_size > limits.max_compute_work_group_size[0]
+            || capture.local_size > limits.max_compute_work_group_invocations
+            || module
+                .required_subgroup_size
+                .is_some_and(|n| n == 0 || capture.local_size % n != 0)
+            || (full && (subgroup_size == 0 || capture.local_size % subgroup_size != 0))
