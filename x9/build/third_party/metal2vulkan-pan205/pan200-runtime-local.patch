+/// Whether a vertex entry requires subgroup execution on a profile lacking native vertex
+/// subgroups. The read-only barrier proof is the same one used by barrier selection.
+pub(crate) fn needs_vertex_capture(entry: &crate::air::Entry, profile: &crate::device::DeviceProfile) -> bool {
+    if profile.fields().subgroup.stage(Stage::Vertex).supported
+        || profile.takes_driver_deviation(crate::error::DriverDeviation::MetalVertexSimdgroups)
+    {
+        return false;
+    }
+    let Some(body) = entry.module.func(entry.func).and_then(|f| f.body.as_ref()) else {
+        return false;
+    };
+    use crate::air::abi::{Builtin, ParamRole};
+    if entry.ep.params.iter().any(|p| matches!(p.role,
+        ParamRole::Builtin(Builtin::ThreadIndexInSimdgroup | Builtin::ThreadIndexInQuadgroup))) {
+        return true;
+    }
+    let independent = crate::lower::sync::barrier::independent_vertex(body);
+    body.insts.values().any(|inst| match &inst.kind {
+        InstKind::Call(call) => match &call.callee {
+            Callee::Air { op: AirIntrinsic::Group(_) | AirIntrinsic::SimdMatrix(_), .. }
+            | Callee::Llvm { op: LlvmIntrinsic::Agx(_), .. } => true,
+            Callee::Air { op: AirIntrinsic::Sync(crate::air::intrinsics::Sync::Barrier { scope: crate::air::intrinsics::ThreadScope::Simdgroup, flags, .. }), .. } => !independent || flags.threadgroup || flags.threadgroup_imageblock || flags.object_data,
+            _ => false,
+        },
+        _ => false,
+    })
+}
