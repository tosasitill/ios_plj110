+/// Guard the entire captured vertex body, not just its output stores. In particular, padding
+/// invocations must not fetch attributes, participate in reductions, or write Metal resources.
+pub fn wrap_capture_entry(
+    cx: &mut EmitCx<'_>,
+    mb: &mut ModuleBuilder,
+    body: crate::spirv::ids::FuncId,
+) -> BResult<crate::spirv::ids::FuncId> {
+    if !cx
+        .plan
+        .families
+        .stage_io
+        .capture
+        .as_ref()
+        .is_some_and(|c| c.partial_groups)
+    {
+        return Ok(body);
+    }
+    let void = mb.ty(SType::Void)?;
+    let mut fb = mb.function(void)?;
+    let (buffer, vertex, _) = capture_ids(cx, &mut fb)?;
+    let count = capture_word(&mut fb, buffer, 0)?;
+    let active = fb.binary(BinOp::ULessThan, vertex, count)?;
+    fb.if_(
+        cx,
+        active,
+        Box::new(move |fb, _| {
+            fb.call(body, &[])?;
+            Ok(crate::spirv::builder::constructs::ArmEnd::FallThrough(
+                Vec::new(),
+            ))
+        }),
+        None,
+    )?;
+    fb.ret(None)?;
+    fb.finish()
+}
