+        if capture.local_size == 0
+            || capture.stride_words == 0
+            || (!capture.partial_groups && vertex_count % capture.local_size != 0)
+            || vertex_start
+                .checked_add(vertex_count.saturating_sub(1))
+                .is_none()
+            || base_instance
+                .checked_add(instance_count.saturating_sub(1))
+                .is_none()
+        {
+            return Err(refuse());
+        }
+        let words = u64::from(vertex_count)
+            .checked_mul(u64::from(instance_count))
+            .and_then(|n| n.checked_mul(u64::from(capture.stride_words)))
+            .and_then(|n| n.checked_add(4))
+            .ok_or_else(refuse)?;
+        let bytes = words.checked_mul(4).ok_or_else(refuse)?;
+        let groups = [vertex_count.div_ceil(capture.local_size), instance_count, 1];
