+//! Bit-preserving compute transfers for linear image shadows without transfer usage.
+use super::Device;
+use super::binding_view::VkView;
+use super::error::{Error,RuntimeGap};
+use super::image_plan::{ImagePlan,ImageFacts,compatible};
+use super::owned_kernel::{OwnedModule,OwnedKernel,OwnedBinds,OwnedSet};
+use super::tracker::Barrier;
+use crate::device::functions::Vk;
+use ash::vk;
+use metal2vulkan::bind::{RawShadowTexel,RawShadowDirection,RawShadowModule};
+use metal2vulkan::vk::{FormatFeatureFlags2 as F,ImageCreateFlags as C,ImageUsageFlags as U,ImageAspectFlags};
+use std::sync::Arc;
+
+/// Add a compatible integer view with the usages the actual format supports.
+/// Linear textures have one mip and single-sampled 2D images (possibly arrays).
+pub(super) fn plan(mut plan:ImagePlan,facts:&ImageFacts<'_>)->Option<(ImagePlan,RawShadowTexel)> {
+    if plan.levels!=1 || plan.samples.as_raw()!=1 || plan.extent[2]!=1 {return None;}
+    let block=plan.format.block()?;
+    if block.texels!=1 || block.color.is_none() {return None;}
+    let texel=RawShadowTexel::of_bytes(block.size)?;
+    let format=texel.format();
+    if !compatible(plan.format,format,false) || !facts.optimal(format).contains(F::SAMPLED_IMAGE|F::STORAGE_IMAGE) {return None;}
+    let unrestricted=plan.flags.contains(C::MUTABLE_FORMAT) && plan.view_formats.is_empty();
+    plan.flags|=C::MUTABLE_FORMAT;
+    if !facts.optimal(plan.format).contains(F::SAMPLED_IMAGE|F::STORAGE_IMAGE) {plan.flags|=C::EXTENDED_USAGE;}
+    plan.usage|=U::SAMPLED|U::STORAGE;
+    if !unrestricted {
+        if plan.view_formats.is_empty(){plan.view_formats.push(plan.format);}
+        if !plan.view_formats.contains(&format){plan.view_formats.push(format);}
+    }
+    Some((plan,texel))
+}
+
+pub(super) fn view(texel:RawShadowTexel,layers:u32)->VkView {
+    VkView{view_type:metal2vulkan::vk::ImageViewType::TYPE_2D_ARRAY,format:texel.format(),
+        components:metal2vulkan::vk::ComponentMapping::IDENTITY,aspect:ImageAspectFlags::COLOR,
+        base_level:0,level_count:1,base_layer:0,layer_count:layers,usage:U::SAMPLED|U::STORAGE}
+}
+struct Run {kernel:OwnedKernel,binds:OwnedBinds}
