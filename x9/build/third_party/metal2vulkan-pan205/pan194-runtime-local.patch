+//! Timestamp counter sample buffers backed by real Vulkan timestamp queries.
+//! A fresh query is retained for each encoded sample so reuse of an index cannot
+//! reset a query still referenced by an earlier command buffer.
+use crate::device::lock;
+use crate::encoder::EncoderCore;
+use crate::error::{invalid, vulkan, Error, Problem, RuntimeGap};
+use crate::tracker::Barrier;
+use crate::{exit_guard, release, BlitCommandEncoder, ComputeCommandEncoder, Device};
+use ash::vk;
+use std::sync::{Arc, Mutex};
+
+/// `MTLCounterSampleBuffer` for the timestamp counter set. Results are GPU ticks;
+/// an absent or not-yet-available sample resolves to `MTLCounterErrorValue`.
+#[derive(Clone)]
+pub struct CounterSampleBuffer(Arc<Samples>);
+struct Samples {
+    device: Device,
+    slots: Mutex<Vec<Option<Arc<Sample>>>>,
+}
+pub(crate) struct Sample {
+    device: Device,
+    pool: vk::QueryPool,
+}
+impl std::fmt::Debug for CounterSampleBuffer {
+    fn fmt(&self,f:&mut std::fmt::Formatter<'_>)->std::fmt::Result {f.debug_struct("CounterSampleBuffer").field("sample_count",&self.sample_count()).finish()}
+}
+impl Drop for Sample {
+    fn drop(&mut self) {
+        if let Some(_busy)=exit_guard::enter() {
+            // SAFETY: the encoder retains this sample until its commands complete.
+            unsafe {release::object(self.device.shared().vk(),self.pool)};
+        }
+    }
+}
+impl Device {
+    /// Whether the selected queue family can write hardware timestamps.
+    pub fn supports_timestamp_counters(&self)->bool {self.owns_vulkan_device() && self.shared().timing.clock().is_some()}
+    /// `newCounterSampleBufferWithDescriptor:error:` for the timestamp set,
+    /// with at most 4096 samples (32768 resolved bytes).
+    pub fn new_counter_sample_buffer(&self,count:usize)->Result<CounterSampleBuffer,Error> {
+        if count==0||count>4096{return Err(invalid("new_counter_sample_buffer",Problem::LengthMismatch))}
+        if !self.supports_timestamp_counters(){return Err(Error::NotImplemented(RuntimeGap::CounterSampleBuffers))}
+        Ok(CounterSampleBuffer(Arc::new(Samples{device:self.clone(),slots:Mutex::new(vec![None;count])})))
+    }
+}
+impl CounterSampleBuffer {
+    /// `sampleCount`.
+    pub fn sample_count(&self)->usize {lock(&self.0.slots).len()}
+    /// The device whose query pools hold these samples.
+    pub fn device(&self)->&Device {&self.0.device}
+    pub(crate) fn prepare(&self,index:usize)->Result<Arc<Sample>,Error> {
+        let Some(_busy)=exit_guard::enter() else {return Err(Error::NotImplemented(RuntimeGap::CounterSampleBuffers))};
+        let mut slots=lock(&self.0.slots);
+        let destination=slots.get_mut(index).ok_or_else(||invalid("sample_counters",Problem::LengthMismatch))?;
+        let raw=self.device().shared().vk();
+        let info=vk::QueryPoolCreateInfo::default().query_type(vk::QueryType::TIMESTAMP).query_count(1);
+        // SAFETY: this device was created with hostQueryReset enabled. This fresh
+        // pool is unpublished and no command can access its query yet.
+        let pool=unsafe{raw.create_query_pool(&info,None)}.map_err(vulkan)?;
+        unsafe{raw.reset_query_pool(pool,0,1)};
+        let sample=Arc::new(Sample{device:self.device().clone(),pool});
+        *destination=Some(sample.clone());Ok(sample)
+    }
+    /// `resolveCounterRange:`: available samples in `[start,start+count)`,
+    /// without waiting on queries that have never been submitted.
+    pub fn resolve(&self,start:usize,count:usize)->Result<Vec<u64>,Error> {
+        let Some(_busy)=exit_guard::enter() else {return Err(Error::NotImplemented(RuntimeGap::CounterSampleBuffers))};
+        let slots=lock(&self.0.slots);
+        let range=start.checked_add(count).filter(|end|*end<=slots.len()).ok_or_else(||invalid("resolve_counters",Problem::LengthMismatch))?;
+        let mut values=Vec::with_capacity(count);
+        for slot in &slots[start..range] {
+            let mut value=[u64::MAX];
+            if let Some(sample)=slot {
+                // SAFETY: pool and output are live, and one 64-bit result is requested.
+                match unsafe{self.device().shared().vk().get_query_pool_results(sample.pool,0,&mut value,vk::QueryResultFlags::TYPE_64)} {
+                    Ok(())=>{},Err(vk::Result::NOT_READY)=>value[0]=u64::MAX,Err(error)=>return Err(vulkan(error)),
+                }
+            }
+            values.push(value[0]);
+        }
+        Ok(values)
+    }
+}
+impl Sample {
+    /// Write this freshly reset query at the command's actual execution point.
+    pub(crate) fn write(&self,raw:&crate::device::functions::Vk,command:vk::CommandBuffer) {
+        // SAFETY: the encoder owns this recording and retains the query until completion.
+        unsafe{raw.cmd_write_timestamp(command,vk::PipelineStageFlags::BOTTOM_OF_PIPE,self.pool,0)};
+    }
+}
+impl EncoderCore {
+    fn sample_timestamp(&mut self,buffer:&CounterSampleBuffer,index:usize,barrier:bool)->Result<(),Error> {
+        self.check_device("sample_counters",buffer.device())?;
+        let sample=buffer.prepare(index)?;
+        if barrier{self.barrier(Barrier::everything());}
+        self.command(vk::PipelineStageFlags2::ALL_COMMANDS,&[],|raw,command|sample.write(raw,command));
+        self.retain(sample);Ok(())
+    }
+}
+impl BlitCommandEncoder {
+    /// `sampleCountersInBuffer:atSampleIndex:withBarrier:` using a GPU timestamp.
+    pub fn sample_counters_in_buffer(&mut self,buffer:&CounterSampleBuffer,index:usize,barrier:bool)->Result<(),Error> {
+        self.core().sample_timestamp(buffer,index,barrier)
+    }
+}
+impl ComputeCommandEncoder {
+    /// `sampleCountersInBuffer:atSampleIndex:withBarrier:` using a GPU timestamp.
+    pub fn sample_counters_in_buffer(&mut self,buffer:&CounterSampleBuffer,index:usize,barrier:bool)->Result<(),Error> {
+        self.core().sample_timestamp(buffer,index,barrier)
+    }
+}
+
+impl BlitCommandEncoder {
+    /// `resolveCounters:inRange:destinationBuffer:destinationOffset:` records
+    /// actual query copies into the destination, ordered with the encoder.
+    pub fn resolve_counters(&mut self,counters:&CounterSampleBuffer,start:usize,count:usize,destination:&crate::Buffer,offset:u64)->Result<(),Error> {
+        self.core().check_device("resolve_counters",counters.device())?;
+        self.core().check_device("resolve_counters",destination.device())?;
+        let bytes=(count as u64).checked_mul(8).ok_or_else(||invalid("resolve_counters",Problem::LengthMismatch))?;
+        if offset%8!=0||offset>destination.length()||bytes>destination.length()-offset{return Err(invalid("resolve_counters",Problem::LengthMismatch))}
+        let slots=lock(&counters.0.slots);
+        let end=start.checked_add(count).filter(|end|*end<=slots.len()).ok_or_else(||invalid("resolve_counters",Problem::LengthMismatch))?;
+        let samples=slots[start..end].to_vec();drop(slots);
+        let (buffer,base)=destination.at(offset);
+        let uses=[crate::blit::writes(destination,offset..offset+bytes)];
+        self.command(&uses,|raw,command| {
+            for (i,sample) in samples.iter().enumerate() {
+                let at=base+i as u64*8;
+                // SAFETY: the checked range is writable, every pool is retained,
+                // and samples are resolved only after commands that wrote them.
+                unsafe{match sample {
+                    Some(sample)=>raw.cmd_copy_query_pool_results(command,sample.pool,0,1,buffer,at,8,vk::QueryResultFlags::TYPE_64|vk::QueryResultFlags::WAIT),
+                    None=>raw.cmd_fill_buffer(command,buffer,at,8,u32::MAX),
+                }}
+            }
+        })?;
+        self.core().retain(samples);Ok(())
+    }
+}
