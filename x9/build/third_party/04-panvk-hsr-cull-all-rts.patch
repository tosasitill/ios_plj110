diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -1,6 +1,107 @@
 #ifdef X9_NATIVE_KMOD
 /* X9 native compiler/device CSF access. */
 #include "X9PanVKSync.h"
+#include <stdlib.h>
+#include <string.h>
+#include <sys/sysctl.h>
+#include <pthread.h>
+
+/* HSR cull policy, chosen once per process from an exact boot-arg token:
+ *   (none) 1: hsr_can_cull additionally requires that the draw really writes
+ *             every bound colour RT (legacy FPK's !(rt_mask & ~rt_written)),
+ *             counting colour-write-disabled/zero-mask RTs as unwritten;
+ *   x9h2   2: unmodified upstream rule (comparison only);
+ *   x9h0   0: hsr_can_cull=0 and hsr_can_be_culled=0 for every draw.
+ * Only ever removes culling relative to upstream; never adds it. */
+static int __attribute__((unused))
+x9_hsr_mode(void)
+{
+   static int mode = -1;
+   int m = __atomic_load_n(&mode, __ATOMIC_RELAXED);
+   if (m >= 0)
+      return m;
+   m = 1;
+   char args[4096] = {0};
+   size_t bytes = sizeof(args) - 1;
+   if (!sysctlbyname("kern.bootargs", args, &bytes, NULL, 0)) {
+      args[sizeof(args) - 1] = 0;
+      for (const char *p = args; *p;) {
+         while (*p && (unsigned char)*p <= 32)
+            p++;
+         const char *end = p;
+         while (*end && (unsigned char)*end > 32)
+            end++;
+         if (end - p == 4 && !memcmp(p, "x9h0", 4))
+            m = 0;
+         else if (end - p == 4 && !memcmp(p, "x9h2", 4))
+            m = 2;
+         p = end;
+      }
+   }
+   __atomic_store_n(&mode, m, __ATOMIC_RELAXED);
+   x9_panvk_log("X9 HSR policy: proc=%s mode=%d;1=all-bound-RTs-written 2=upstream 0=off",
+                getprogname(), m);
+   return m;
+}
+
+/* Bounded evidence: up to 48 distinct DCD signatures per process, plus
+ * running totals at power-of-two draw counts (>=256) and every 65536. */
+static void __attribute__((unused))
+x9_hsr_note(uint32_t rt_mask, uint32_t written, uint32_t effective,
+            uint32_t read, bool dest_read, bool ld_tile, bool coverage,
+            bool upstream_cull, bool cull, bool be_culled, int mode)
+{
+   static uint64_t total, up_total, cull_total, blocked_total, be_total;
+   static uint32_t seen[48];
+   static unsigned seen_count;
+   static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+
+   uint64_t n = __atomic_add_fetch(&total, 1, __ATOMIC_RELAXED);
+   if (upstream_cull)
+      __atomic_add_fetch(&up_total, 1, __ATOMIC_RELAXED);
+   if (cull)
+      __atomic_add_fetch(&cull_total, 1, __ATOMIC_RELAXED);
+   if (upstream_cull && !cull)
+      __atomic_add_fetch(&blocked_total, 1, __ATOMIC_RELAXED);
+   if (be_culled)
+      __atomic_add_fetch(&be_total, 1, __ATOMIC_RELAXED);
+
+   uint32_t sig = (rt_mask & 0xff) | (written & 0xff) << 8 |
+                  (effective & 0xff) << 16 | (read & 0x3f) << 24 |
+                  (uint32_t)dest_read << 30 | (uint32_t)ld_tile << 31;
+   uint32_t flags = (uint32_t)coverage | (uint32_t)upstream_cull << 1 |
+                    (uint32_t)cull << 2 | (uint32_t)be_culled << 3;
+   uint32_t key = sig ^ (flags * 0x9e3779b1u);
+   unsigned count = __atomic_load_n(&seen_count, __ATOMIC_ACQUIRE);
+   bool known = false;
+   for (unsigned i = 0; i < count && !known; i++)
+      known = __atomic_load_n(&seen[i], __ATOMIC_RELAXED) == key;
+   if (!known && count < 48) {
+      pthread_mutex_lock(&lock);
+      known = false;
+      for (unsigned i = 0; i < seen_count && !known; i++)
+         known = seen[i] == key;
+      if (!known && seen_count < 48) {
+         __atomic_store_n(&seen[seen_count], key, __ATOMIC_RELAXED);
+         __atomic_store_n(&seen_count, seen_count + 1, __ATOMIC_RELEASE);
+         x9_panvk_log("X9 HSR DCD: proc=%s mode=%d sig=%u draw=%llu rt_mask=%x "
+                      "written=%x effective=%x read=%x dest_read=%u ld_tile=%u "
+                      "coverage=%u upstream_can_cull=%u can_cull=%u can_be_culled=%u",
+                      getprogname(), mode, seen_count, (unsigned long long)n,
+                      rt_mask, written, effective, read, dest_read, ld_tile,
+                      coverage, upstream_cull, cull, be_culled);
+      }
+      pthread_mutex_unlock(&lock);
+   }
+   if ((n >= 256 && !(n & (n - 1))) || !(n % 65536))
+      x9_panvk_log("X9 HSR totals: proc=%s mode=%d draws=%llu upstream_can_cull=%llu "
+                   "can_cull=%llu blocked=%llu can_be_culled=%llu",
+                   getprogname(), mode, (unsigned long long)n,
+                   (unsigned long long)__atomic_load_n(&up_total, __ATOMIC_RELAXED),
+                   (unsigned long long)__atomic_load_n(&cull_total, __ATOMIC_RELAXED),
+                   (unsigned long long)__atomic_load_n(&blocked_total, __ATOMIC_RELAXED),
+                   (unsigned long long)__atomic_load_n(&be_total, __ATOMIC_RELAXED));
+}
 #endif
