+                   (i < ARRAY_SIZE(dyns->cb.attachments) &&
+                    !dyns->cb.attachments[i].write_mask))
+                  effective &= ~BITFIELD_BIT(i);
+            }
+            const bool upstream_cull = cfg.hsr_can_cull;
+            if (mode == 0) {
+               cfg.hsr_can_cull = false;
+               cfg.hsr_can_be_culled = false;
+            } else if (mode == 1) {
+               cfg.hsr_can_cull = upstream_cull && effective &&
+                                  !(rt_mask & ~effective);
+            }
+            x9_hsr_note(rt_mask, out->rt_written, effective, out->rt_read,
+                        cmdbuf->state.gfx.cb.info.any_dest_read,
+                        fs->info.fs.hsr.ld_tile, shader_modifies_coverage,
+                        upstream_cull, cfg.hsr_can_cull,
+                        cfg.hsr_can_be_culled, mode);
+         }
+#endif
+
          /* Late HSR update */
          cfg.hsr_update_operation = shader_modifies_coverage || late_zs
                                        ? MALI_HSR_UPDATE_LATE
