diff --git a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
--- a/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/csf/panvk_vX_cmd_draw.c
@@ -4165,10 +4165,44 @@
    for (uint32_t i = 0; i < addr_count; i++) {
       panvk_per_arch(cmd_invalidate_crc)(b, addrs[i]);
    }
 }
 
+#ifdef X9_NATIVE_KMOD
+/* Diagnostic A/B (exact boot-arg token x9s1): make every render pass's
+ * vertex/tiler work wait until all earlier fragment work of this queue has
+ * completed, so no two render passes overlap on the GPU. Default off. */
+static bool
+x9_serialize_passes(void)
+{
+   static int mode = -1;
+   int m = __atomic_load_n(&mode, __ATOMIC_RELAXED);
+   if (m >= 0)
+      return m;
+   m = 0;
+   char args[4096] = {0};
+   size_t bytes = sizeof(args) - 1;
+   if (!sysctlbyname("kern.bootargs", args, &bytes, NULL, 0)) {
+      args[sizeof(args) - 1] = 0;
+      for (const char *p = args; *p;) {
+         while (*p && (unsigned char)*p <= 32)
+            p++;
+         const char *end = p;
+         while (*end && (unsigned char)*end > 32)
+            end++;
+         if (end - p == 4 && !memcmp(p, "x9s1", 4))
+            m = 1;
+         p = end;
+      }
+   }
+   __atomic_store_n(&mode, m, __ATOMIC_RELAXED);
+   x9_panvk_log("X9 PASS SERIALIZE: proc=%s mode=%d;1=VT waits previous fragment (x9s1)",
+                getprogname(), m);
+   return m;
+}
+#endif
+
