+#ifdef X9_NATIVE_KMOD
+/* Diagnostic A/B (exact boot-arg token x9c0): no transaction-elimination CRC
+ * on any image, as PANVK_DEBUG=no_crc. Swipe-only mosaic that clears when
+ * motion stops matches stale CRC tiles after writes CRC tracking misses. */
 static bool
+x9_no_crc(void)
+{
+   static int mode = -1;
+   int m = __atomic_load_n(&mode, __ATOMIC_RELAXED);
+   if (m >= 0)
+      return m;
+   m = 0;
+   char args[4096] = {0};
+   size_t bytes = sizeof(args) - 1;
+   if (!sysctlbyname("kern.bootargs", args, &bytes, NULL, 0)) {
+      args[sizeof(args) - 1] = 0;
+      for (const char *p = args; *p;) {
+         while (*p && (unsigned char)*p <= 32)
+            p++;
+         const char *end = p;
+         while (*end && (unsigned char)*end > 32)
+            end++;
+         if (end - p == 4 && !memcmp(p, "x9c0", 4))
+            m = 1;
+         p = end;
+      }
+   }
+   __atomic_store_n(&mode, m, __ATOMIC_RELAXED);
+   x9_panvk_log("X9 CRC: proc=%s mode=%d;1=transaction elimination off (x9c0)", getprogname(), m);
+   return m;
+}
+#endif
