@@ -0,0 +1,374 @@
+//! A vertex stage that reads linear capture records.
+//!
+//! The buffer starts with `VertexCapture::HEADER_WORDS` words, followed by fixed-size records of
+//! `u32` words, ordered by instance then vertex. An indexed capture also appends its index stream;
+//! only the producer reads that stream. The pull draw uses zero first vertex and first instance.
+//! This module only constructs the pull stage; a producer must write exactly this layout.
+
+use crate::budget::Meter;
+use crate::device::DeviceProfile;
+use crate::device::requirements::Requirements;
+use crate::error::Error;
+use crate::lower::stage_io::{IoObject, Shape};
+use crate::pipeline::artifact::{Reconvergence, SpecializationLayout, StageModule, StrategyCensus};
+use crate::pipeline::interface::{RecordField, RecordValue};
+use crate::pipeline::link::mesh::{ku, lanes, scalar, word};
+use crate::pipeline::stage_io::IoNumeric;
+use crate::pipeline::sym::ResourceSlot;
+use crate::spirv::builder::{FunctionBuilder, ModuleBuilder};
+use crate::spirv::error::{BResult, BuildError, TypeRule};
+use crate::spirv::ids::{GlobalId, Value};
+use crate::spirv::ir::{
+    BinOp, ConstBits, Constant, ConvOp, ExecModel, IoDecor, IoDir, LayoutRule, MemAccess,
+    StorageClass, Type, TypedModule, natural_layout,
+};
+use crate::spirv::serialize::{ENTRY_NAME, SymbolTable};
+use crate::spv::BuiltIn;
+use crate::vk;
+use std::collections::HashSet;
+
+/// One captured output and its original interface decorations.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CaptureField {
+    /// Word offset, type and output identity.
+    pub record: RecordField,
+    /// Interpolation and location packing of a user varying.
+    pub decoration: IoDecor,
+    /// Whether the original output was invariant.
+    pub invariant: bool,
+}
+
+impl From<&CaptureField> for crate::pipeline::interface::VertexCaptureField {
+    fn from(field: &CaptureField) -> Self {
+        use crate::spirv::ir::{Interpolation, Sampling};
+        Self {
+            record: field.record.clone(),
+            flat: field.decoration.interpolation == Interpolation::Flat,
+            no_perspective: field.decoration.interpolation == Interpolation::NoPerspective,
+            centroid: field.decoration.sampling == Sampling::Centroid,
+            sample: field.decoration.sampling == Sampling::Sample,
+            packed: field.decoration.packed,
+            index: field.decoration.index,
+            invariant: field.invariant,
+        }
+    }
+}
+
+impl TryFrom<&crate::pipeline::interface::VertexCaptureField> for CaptureField {
+    type Error = BuildError;
+    fn try_from(field: &crate::pipeline::interface::VertexCaptureField) -> BResult<Self> {
+        use crate::spirv::ir::{Interpolation, Sampling};
+        if (field.flat && field.no_perspective) || (field.centroid && field.sample) {
+            return Err(BuildError::Type(TypeRule::VectorShape));
+        }
+        Ok(Self {
+            record: field.record.clone(),
+            decoration: IoDecor {
+                interpolation: if field.flat {
+                    Interpolation::Flat
+                } else if field.no_perspective {
+                    Interpolation::NoPerspective
+                } else {
+                    Interpolation::Smooth
+                },
+                sampling: if field.centroid {
+                    Sampling::Centroid
+                } else if field.sample {
+                    Sampling::Sample
+                } else {
+                    Sampling::Center
+                },
+                packed: field.packed,
+                index: field.index,
+            },
+            invariant: field.invariant,
+        })
+    }
+}
+
+/// Verify, serialize and relocate a capture pull stage under the pipeline's link table.
+pub fn synthesized_stage(
+    records: ResourceSlot,
+    stride: u32,
+    fields: &[CaptureField],
+    table: &impl SymbolTable,
+    profile: &DeviceProfile,
+    meter: &mut Meter,
+) -> Result<(StageModule, Requirements), Error> {
+    let module = vertex_module(records, stride, fields)?;
+    let stats = crate::spirv::verify::verify(&module, profile, meter)?;
+    let module = crate::spirv::serialize::serialize_for(module, profile)?;
+    let words = crate::spirv::serialize::relocate(&module, table)?;
+    Ok((
+        StageModule {
+            stage: vk::ShaderStage::VERTEX,
+            entry_point: ENTRY_NAME.to_owned(),
+            spirv: words.into(),
+            specialization: SpecializationLayout::default(),
+            required_subgroup_size: None,
+            stage_flags: vk::PipelineShaderStageCreateFlags::empty(),
+            reconvergence: Reconvergence::Guaranteed,
+            precision_notes: Vec::new(),
+            strategies: StrategyCensus::default(),
+            constant_blob: None,
+            rounded_colors: Vec::new(),
+            specialized_notes: Vec::new(),
+            own_pixel_textures: Vec::new(),
+            snapshot_textures: Vec::new(),
+            private_bytes: 0,
+            stats,
+        },
+        module.requirements,
+    ))
+}
+
+/// Derive the record layout and corresponding object indices from a planned vertex interface.
+/// Inputs are omitted; an unsupported output shape is rejected rather than silently dropped.
+pub fn output_layout(
+    objects: &[IoObject],
+    invariant: Option<usize>,
+) -> BResult<(Vec<CaptureField>, Vec<usize>, u32)> {
+    let invalid = || BuildError::Type(TypeRule::VectorShape);
+    let mut fields = Vec::new();
+    let mut indices = Vec::new();
+    let mut offset = 0u32;
+    for (index, object) in objects.iter().enumerate() {
+        let (value, numeric, words, decoration) = match object {
+            IoObject::User {
+                key,
+                dir: IoDir::Output,
+                numeric,
+                components,
+                deco,
+                half: false,
+            } => (
+                RecordValue::Varying(key.clone()),
+                *numeric,
+                u32::from(*components),
+                *deco,
+            ),
+            IoObject::Builtin {
+                builtin,
+                dir: IoDir::Output,
+                shape,
+                ..
+            } => {
+                let (value, numeric, words) = match (builtin, shape) {
+                    (BuiltIn::Position, Shape::FVec(4)) => {
+                        (RecordValue::Position, IoNumeric::Float, 4)
+                    }
+                    (BuiltIn::PointSize, Shape::F32) => {
+                        (RecordValue::PointSize, IoNumeric::Float, 1)
+                    }
+                    (BuiltIn::ClipDistance, Shape::F32Array(n)) => {
+                        (RecordValue::ClipDistance, IoNumeric::Float, *n)
+                    }
+                    (BuiltIn::Layer, Shape::U32) => (RecordValue::Layer, IoNumeric::Uint, 1),
+                    (BuiltIn::ViewportIndex, Shape::U32) => {
+                        (RecordValue::ViewportIndex, IoNumeric::Uint, 1)
+                    }
+                    _ => return Err(invalid()),
+                };
+                (value, numeric, words, IoDecor::default())
+            }
+            IoObject::User {
+                dir: IoDir::Output, ..
+            } => return Err(invalid()),
+            _ => continue,
+        };
+        fields.push(CaptureField {
+            record: RecordField {
+                value,
+                per_primitive: false,
+                offset,
+                words,
+                numeric,
+            },
+            decoration,
+            invariant: invariant == Some(index),
+        });
+        indices.push(index);
+        offset = offset
+            .checked_add(words)
+            .ok_or(BuildError::IdSpaceExhausted)?;
+    }
+    Ok((fields, indices, offset))
+}
+
+/// Emit stores of one invocation's output globals into its capture record.
+///
+/// `record` is the first word of the invocation's record, including the header offset;
+/// `buffer` is a `Block { uint[] }` storage buffer. Globals have the types described by
+/// `fields`. The caller guards this code for valid invocations and establishes the required
+/// producer-to-vertex memory dependency. This helper does not execute the vertex function.
+pub fn store_record(
+    fb: &mut FunctionBuilder<'_>,
+    buffer: GlobalId,
+    record: Value,
+    fields: &[CaptureField],
+    globals: &[GlobalId],
+) -> BResult<()> {
+    if fields.len() != globals.len() {
+        return Err(BuildError::Type(TypeRule::VectorShape));
+    }
+    let uint = scalar(fb.module(), IoNumeric::Uint)?;
+    let base = fb.module().global_value(buffer)?;
+    let zero = ku(fb, 0)?;
+    for (capture, &global) in fields.iter().zip(globals) {
+        let field = &capture.record;
+        let ptr = fb.module().global_value(global)?;
+        let value = fb.load(ptr, MemAccess::default())?;
+        for lane in 0..field.words {
+            let part = if field.words == 1 && !matches!(field.value, RecordValue::ClipDistance) {
+                value
+            } else {
+                fb.composite_extract(value, &[lane])?
+            };
+            let bits = match field.numeric {
+                IoNumeric::Uint => part,
+                IoNumeric::Float | IoNumeric::Sint => fb.convert(ConvOp::Bitcast, part, uint)?,
+            };
+            let offset = field
+                .offset
+                .checked_add(lane)
+                .ok_or(BuildError::IdSpaceExhausted)?;
+            let offset = ku(fb, offset)?;
+            let at = fb.binary(BinOp::IAdd, record, offset)?;
+            let dst = fb.access_chain(base, &[zero, at])?;
+            fb.store(dst, bits, MemAccess::default())?;
+        }
+    }
+    Ok(())
+}
+
+/// Generate a vertex shader reading captured vertex outputs from `records`.
+///
+/// Every field occupies `words` 32-bit words from its `offset` in a record of `stride` words.
+/// All fields are per vertex; a position must be supplied. The caller must allocate the buffer,
+/// write its header and records, synchronize the producer with vertex reads, bind it at `records`,
+/// and draw with first vertex and first instance zero. This does not generate a capture producer.
+pub fn vertex_module(
+    records: ResourceSlot,
+    stride: u32,
+    fields: &[CaptureField],
+) -> BResult<TypedModule> {
+    let invalid = || BuildError::Type(TypeRule::VectorShape);
+    let mut seen = HashSet::new();
+    let mut occupied = Vec::new();
+    let mut position = false;
+    for capture in fields {
+        let field = &capture.record;
+        let end = field.offset.checked_add(field.words).ok_or_else(invalid)?;
+        if field.per_primitive
+            || field.words == 0
+            || end > stride
+            || occupied
+                .iter()
+                .any(|&(start, stop)| field.offset < stop && start < end)
+            || !seen.insert(field.value.clone())
+        {
+            return Err(invalid());
+        }
+        occupied.push((field.offset, end));
+        match &field.value {
+            RecordValue::Position if field.numeric == IoNumeric::Float && field.words == 4 => {
+                position = true
+            }
+            RecordValue::PointSize if field.numeric == IoNumeric::Float && field.words == 1 => (),
+            RecordValue::ClipDistance if field.numeric == IoNumeric::Float => (),
+            RecordValue::Layer | RecordValue::ViewportIndex
+                if field.numeric == IoNumeric::Uint && field.words == 1 =>
+            {
+                ()
+            }
+            RecordValue::Varying(_) if field.words <= 4 => (),
+            _ => return Err(invalid()),
+        }
+    }
+    if !position {
+        return Err(invalid());
+    }
+
+    let mut mb = ModuleBuilder::new();
+    let u32_ = scalar(&mut mb, IoNumeric::Uint)?;
+    let void = mb.ty(Type::Void)?;
+    let words = mb.ty(Type::RuntimeArray {
+        elem: u32_,
+        stride: Some(4),
+    })?;
+    let layout = natural_layout(mb.types(), LayoutRule::Std430, true, &[words])?;
+    let block = mb.ty(Type::Struct {
+        members: [words].into(),
+        layout: Some(layout),
+    })?;
+    let buffer = mb.resource(records, StorageClass::StorageBuffer, block)?;
+    let vertex = mb.builtin(BuiltIn::VertexIndex, IoDir::Input, u32_)?;
+    let instance = mb.builtin(BuiltIn::InstanceIndex, IoDir::Input, u32_)?;
+    let mut outputs = Vec::with_capacity(fields.len());
+    for capture in fields {
+        let field = &capture.record;
+        let elem = scalar(&mut mb, field.numeric)?;
+        let ty = match &field.value {
+            RecordValue::ClipDistance => {
+                let len = mb.constant(Constant::Scalar {
+                    ty: u32_,
+                    bits: ConstBits(u64::from(field.words)),
+                })?;
+                mb.ty(Type::Array {
+                    elem,
+                    len,
+                    stride: None,
+                })?
+            }
+            _ if field.words == 1 => elem,
+            _ => mb.ty(Type::Vector {
+                elem,
+                len: field.words as u8,
+            })?,
+        };
+        let global = match &field.value {
+            RecordValue::Position => mb.builtin(BuiltIn::Position, IoDir::Output, ty)?,
+            RecordValue::PointSize => mb.builtin(BuiltIn::PointSize, IoDir::Output, ty)?,
+            RecordValue::ClipDistance => mb.builtin(BuiltIn::ClipDistance, IoDir::Output, ty)?,
+            RecordValue::Layer => mb.builtin(BuiltIn::Layer, IoDir::Output, ty)?,
+            RecordValue::ViewportIndex => mb.builtin(BuiltIn::ViewportIndex, IoDir::Output, ty)?,
+            RecordValue::Varying(key) => {
+                mb.io(key.clone(), IoDir::Output, ty, capture.decoration)?
+            }
+            _ => return Err(invalid()),
+        };
+        if capture.invariant {
+            mb.invariant(global)?;
+        }
+        outputs.push((field, global, ty));
+    }
+    let mut fb = mb.function(void)?;
+    let vp = fb.module().global_value(vertex)?;
+    let v = fb.load(vp, MemAccess::default())?;
+    let ip = fb.module().global_value(instance)?;
+    let i = fb.load(ip, MemAccess::default())?;
+    let count_word = ku(&mut fb, crate::pipeline::interface::VertexCapture::COUNT)?;
+    let count = word(&mut fb, buffer, count_word)?;
+    let instance_base = fb.binary(BinOp::IMul, i, count)?;
+    let ordinal = fb.binary(BinOp::IAdd, instance_base, v)?;
+    let stride = ku(&mut fb, stride)?;
+    let offset = fb.binary(BinOp::IMul, ordinal, stride)?;
+    let header = ku(
+        &mut fb,
+        crate::pipeline::interface::VertexCapture::HEADER_WORDS,
+    )?;
+    let record = fb.binary(BinOp::IAdd, offset, header)?;
+    for (field, global, ty) in outputs {
+        let parts = lanes(&mut fb, buffer, record, field)?;
+        let value = match parts.as_slice() {
+            [single] if !matches!(field.value, RecordValue::ClipDistance) => *single,
+            _ => fb.composite_construct(ty, &parts)?,
+        };
+        let ptr = fb.module().global_value(global)?;
+        fb.store(ptr, value, MemAccess::default())?;
+    }
+    fb.ret(None)?;
+    let entry = fb.finish()?;
+    mb.entry(ExecModel::Vertex, entry, Vec::new())?;
+    mb.finalize()
+}
