diff --git a/crates/metal2vulkan-runtime/src/raw_shadow.rs b/crates/metal2vulkan-runtime/src/raw_shadow.rs
new file mode 100644
index 00000000..9fecbc87
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/raw_shadow.rs
@@ -0,0 +1,104 @@
+//! Bit-preserving compute transfers for linear image shadows without transfer usage.
+use super::Device;
+use super::binding_view::VkView;
+use super::error::{Error,RuntimeGap};
+use super::image_plan::{ImagePlan,ImageFacts,compatible};
+use super::owned_kernel::{OwnedModule,OwnedKernel,OwnedBinds,OwnedSet};
+use super::tracker::Barrier;
+use crate::device::functions::Vk;
+use ash::vk;
+use metal2vulkan::bind::{RawShadowTexel,RawShadowDirection,RawShadowModule};
+use metal2vulkan::vk::{FormatFeatureFlags2 as F,ImageCreateFlags as C,ImageUsageFlags as U,ImageAspectFlags};
+use std::sync::Arc;
+
+/// Add a compatible integer view with the usages the actual format supports.
+/// Linear textures have one mip and single-sampled 2D images (possibly arrays).
+pub(super) fn plan(mut plan:ImagePlan,facts:&ImageFacts<'_>)->Option<(ImagePlan,RawShadowTexel)> {
+    if plan.levels!=1 || plan.samples.as_raw()!=1 || plan.extent[2]!=1 {return None;}
+    let block=plan.format.block()?;
+    if block.texels!=1 || block.color.is_none() {return None;}
+    let texel=RawShadowTexel::of_bytes(block.size)?;
+    let format=texel.format();
+    if !compatible(plan.format,format,false) || !facts.optimal(format).contains(F::SAMPLED_IMAGE|F::STORAGE_IMAGE) {return None;}
+    let unrestricted=plan.flags.contains(C::MUTABLE_FORMAT) && plan.view_formats.is_empty();
+    plan.flags|=C::MUTABLE_FORMAT;
+    if !facts.optimal(plan.format).contains(F::SAMPLED_IMAGE|F::STORAGE_IMAGE) {plan.flags|=C::EXTENDED_USAGE;}
+    plan.usage|=U::SAMPLED|U::STORAGE;
+    if !unrestricted {
+        if plan.view_formats.is_empty(){plan.view_formats.push(plan.format);}
+        if !plan.view_formats.contains(&format){plan.view_formats.push(format);}
+    }
+    Some((plan,texel))
+}
+
+pub(super) fn view(texel:RawShadowTexel,layers:u32)->VkView {
+    VkView{view_type:metal2vulkan::vk::ImageViewType::TYPE_2D_ARRAY,format:texel.format(),
+        components:metal2vulkan::vk::ComponentMapping::IDENTITY,aspect:ImageAspectFlags::COLOR,
+        base_level:0,level_count:1,base_layer:0,layer_count:layers,usage:U::SAMPLED|U::STORAGE}
+}
+struct Run {kernel:OwnedKernel,binds:OwnedBinds}
+pub(super) struct RawImageTransfers {into:Run,back:Run,texel:RawShadowTexel,chunk:[u32;3]}
+impl RawImageTransfers {
+    pub(super) fn new(device:&Device,texel:RawShadowTexel,view:vk::ImageView)->Result<Arc<Self>,Error>{
+        let make=|direction|->Result<Run,Error>{
+            let kernel=device.owned_kernel(OwnedModule::RawShadow(texel,direction))?;
+            let set=OwnedSet{images:if direction==RawShadowDirection::FromImage {vec![view]}else{Vec::new()},
+                storage_images:if direction==RawShadowDirection::IntoImage {vec![view]}else{Vec::new()},buffers:Vec::new()};
+            let binds=OwnedBinds::new(device,&kernel,&[set])?;Ok(Run{kernel,binds})
+        };
+        let max=device.properties().description.limits.max_compute_work_group_count;
+        if max.contains(&0){return Err(Error::NotImplemented(RuntimeGap::Textures));}
+        Ok(Arc::new(Self{into:make(RawShadowDirection::IntoImage)?,back:make(RawShadowDirection::FromImage)?,texel,
+            chunk:[max[0].saturating_mul(RawShadowModule::LOCAL_SIZE),max[1],max[2]]}))
+    }
+    /// The texture's checked layouts imply these bounds; reject before publishing
+    /// its shadow if a shape cannot be represented by this kernel's push ABI.
+    pub(super) fn regions_fit(texel:RawShadowTexel,regions:&[vk::BufferImageCopy])->bool {
+        regions.iter().all(|r|{
+            let width=r.image_extent.width;
+            let row=if r.buffer_row_length==0 {width}else{r.buffer_row_length};
+            let height=if r.buffer_image_height==0 {r.image_extent.height}else{r.buffer_image_height};
+            u64::from(row).checked_mul(u64::from(texel.bytes()))
+                .and_then(|n|n.checked_mul(u64::from(height)))
+                .is_some_and(|n|n<=u64::from(u32::MAX))
+                && r.image_extent.depth==1 && r.image_offset.x>=0 && r.image_offset.y>=0
+                && r.image_subresource.mip_level==0
+        })
+    }
+    /// Record after retained-backing/layout checks; all resources and views live
+    /// until GPU completion. The address is obtained now so detach/rebind cannot
+    /// leave a descriptor referencing a previous VkBuffer.
+    pub(super) unsafe fn record(&self,device:&Vk,command:vk::CommandBuffer,base:u64,regions:&[vk::BufferImageCopy],into:bool){
+        let run=if into {&self.into}else{&self.back};
+        unsafe {
+            Barrier::everything().record(device,command);
+            device.cmd_bind_pipeline(command,vk::PipelineBindPoint::COMPUTE,run.kernel.pipeline);
+            run.binds.bind(device,command,&run.kernel,0);
+        }
+        for r in regions {
+            let row=if r.buffer_row_length==0 {r.image_extent.width}else{r.buffer_row_length};
+            let rows=if r.buffer_image_height==0 {r.image_extent.height}else{r.buffer_image_height};
+            let row_bytes=row*self.texel.bytes();let slice_bytes=row_bytes*rows;
+            for z in (0..r.image_subresource.layer_count).step_by(self.chunk[2] as usize) {
+                for y in (0..r.image_extent.height).step_by(self.chunk[1] as usize) {
+                    for x in (0..r.image_extent.width).step_by(self.chunk[0] as usize) {
+                        let width=(r.image_extent.width-x).min(self.chunk[0]);
+                        let height=(r.image_extent.height-y).min(self.chunk[1]);
+                        let layers=(r.image_subresource.layer_count-z).min(self.chunk[2]);
+                        let address=base+r.buffer_offset+u64::from(z)*u64::from(slice_bytes)+u64::from(y)*u64::from(row_bytes)+u64::from(x)*u64::from(self.texel.bytes());
+                        let words=[r.image_offset.x as u32+x,r.image_offset.y as u32+y,width,height,
+                            row_bytes,slice_bytes,r.image_subresource.base_array_layer+z,0];
+                        let mut push=[0u8;40];
+                        for (dst,n) in push[..32].chunks_exact_mut(4).zip(words){dst.copy_from_slice(&n.to_le_bytes());}
+                        push[32..40].copy_from_slice(&address.to_le_bytes());
+                        unsafe {
+                            device.cmd_push_constants(command,run.kernel.layout,vk::ShaderStageFlags::COMPUTE,0,&push);
+                            device.cmd_dispatch(command,width.div_ceil(RawShadowModule::LOCAL_SIZE),height,layers);
+                        }
+                    }
+                }
+            }
+        }
+        unsafe{Barrier::everything().record(device,command);}
+    }
+}
