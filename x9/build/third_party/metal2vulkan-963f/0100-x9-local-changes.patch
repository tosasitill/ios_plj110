+/// Encode both bytes as normalized channels, with the original output's
+/// alpha available to coverage. Each byte roundtrips through RG8_UNORM exactly;
+/// its 1/255 quotient is far inside that byte's quantization interval.
+pub(crate) fn a1_attachment(fb:&mut FunctionBuilder<'_>,raw:Value,alpha:Value)->BResult<Value>{
+    use crate::spirv::ir::{BinOp,ConvOp};
+    let word=fb.composite_extract(raw,&[0])?;
+    let mask=fb.u32_const(255)?;let mask=fb.module().const_value(mask)?;
+    let shift=fb.u32_const(8)?;let shift=fb.module().const_value(shift)?;
+    let low=fb.binary(BinOp::BitwiseAnd,word,mask)?;
+    let high=fb.binary(BinOp::ShiftRightLogical,word,shift)?;
+    let ft=fb.module().ty(Type::Float{width:32})?;
+    let vt=fb.module().ty(Type::Vector{elem:ft,len:4})?;
+    let c=fb.module().constant(Constant::Scalar{ty:ft,bits:ConstBits(u64::from((1.0f32/255.0).to_bits()))})?;
+    let scale=fb.module().const_value(c)?;
+    let r=fb.convert(ConvOp::ConvertUToF,low,ft)?;
+    let r=fb.binary(BinOp::FMul,r,scale)?;
+    let g=fb.convert(ConvOp::ConvertUToF,high,ft)?;
+    let g=fb.binary(BinOp::FMul,g,scale)?;
+    let z=fb.module().constant(Constant::Null{ty:ft})?;let z=fb.module().const_value(z)?;
+    fb.composite_construct(vt,&[r,g,z,alpha])
+}
