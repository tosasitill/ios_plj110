+fn capture_word(fb: &mut FunctionBuilder<'_>, buffer: GlobalId, index: u32) -> BResult<SValue> {
+    let p = fb.module().global_value(buffer)?;
+    let zero = crate::memory::leaf::k32(fb, 0)?;
+    let index = crate::memory::leaf::k32(fb, index)?;
+    let p = fb.access_chain(p, &[zero, index])?;
+    fb.load(p, MemAccess::default())
