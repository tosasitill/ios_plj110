+    let count = capture_word(fb, buffer, crate::pipeline::interface::VertexCapture::COUNT)?;
+    let row = fb.binary(BinOp::IMul, instance, count)?;
+    let ordinal = fb.binary(BinOp::IAdd, row, vertex)?;
