+impl RenderLowering {
+    /// Record a real timestamp among this render instance's commands.
+    pub(crate) fn sample_counters_in_buffer(
+        &mut self,
+        buffer: &crate::CounterSampleBuffer,
+        index: usize,
+        barrier: bool,
+    ) -> Result<(), Error> {
+        self.log(|_| RenderCall::SampleCounters(buffer.clone(), index, barrier));
+        self.core.check_device("sample_counters", buffer.device())?;
+        if self.later_group_encoder() {
+            return Ok(());
+        }
+        let sample = buffer.prepare(index)?;
+        self.begin_current_draws()?;
+        if barrier {
+            self.barrier_before_next_draw();
+        }
+        if let Some(kept) = &mut self.current.kept {
+            kept.timestamp(sample.clone());
+        } else {
+            sample.write(self.core.device().shared().vk(), self.current.draws);
+        }
+        // A query must not be dropped by draw-only re-recording.
+        self.current.rerecord = None;
+        self.current.recorded = true;
+        self.core.retain(sample);
+        Ok(())
+    }
+}
+impl RenderCommandEncoder {
+    /// `sampleCountersInBuffer:atSampleIndex:withBarrier:` at this render
+    /// command's actual GPU execution point.
+    pub fn sample_counters_in_buffer(
+        &mut self,
+        buffer: &crate::CounterSampleBuffer,
+        index: usize,
+        barrier: bool,
+    ) -> Result<(), Error> {
+        match self.lowers_at_call() {
+            true => {
+                self.at_call(|lowering| lowering.sample_counters_in_buffer(buffer, index, barrier))
+            }
+            false => self.defer(|_| RenderCall::SampleCounters(buffer.clone(), index, barrier)),
+        }
+    }
+}
