+//! X9 metrics (logging only): commit -> kernel-visible submit, measured where the
+//! `vkQueueSubmit` of the batch that ends a command buffer returns (group or alone; once per
+//! command buffer). Not used by any submission decision.
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::time::Instant;
+
+static EPOCH: OnceLock<Instant> = OnceLock::new();
+static COUNT: AtomicU64 = AtomicU64::new(0);
+static SUM_NS: AtomicU64 = AtomicU64::new(0);
+static MAX_NS: AtomicU64 = AtomicU64::new(0);
+
+/// Monotonic nanoseconds since the first call, never 0 (0 means "not committed").
+pub fn now_ns() -> u64 {
+    let epoch = EPOCH.get_or_init(Instant::now);
+    (epoch.elapsed().as_nanos() as u64).saturating_add(1)
+}
+
+/// One command buffer's commit time -> now. Ignores 0.
+pub fn record(commit_ns: u64) {
+    if commit_ns == 0 {
+        return;
+    }
+    let delta = now_ns().saturating_sub(commit_ns);
+    COUNT.fetch_add(1, Ordering::Relaxed);
+    SUM_NS.fetch_add(delta, Ordering::Relaxed);
+    MAX_NS.fetch_max(delta, Ordering::Relaxed);
+}
+
+/// Snapshot and reset: (command buffers, sum of deltas ns, max delta ns).
+pub fn take() -> (u64, u64, u64) {
+    (
+        COUNT.swap(0, Ordering::Relaxed),
+        SUM_NS.swap(0, Ordering::Relaxed),
+        MAX_NS.swap(0, Ordering::Relaxed),
+    )
+}
