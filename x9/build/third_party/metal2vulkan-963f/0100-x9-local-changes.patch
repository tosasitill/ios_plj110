+
+pub(super) fn can_sample_source(device:&Device,source:&Target,aspects:ImageAspectFlags)->Result<bool,Error> {
+    if !image_aspects(source.format).contains(aspects){return Ok(false);}
+    if sampled(source)? {return Ok(true);}
+    let plan=source.texture.image_plan()?;
+    let facts=device.shared().textures.facts(device.compile_device().profile());
+    Ok(plan.usage.contains(metal2vulkan::vk::ImageUsageFlags::TRANSFER_SRC)
+        && facts.optimal(source.format).contains(
+            metal2vulkan::vk::FormatFeatureFlags2::SAMPLED_IMAGE |
+            metal2vulkan::vk::FormatFeatureFlags2::TRANSFER_DST))
+}
