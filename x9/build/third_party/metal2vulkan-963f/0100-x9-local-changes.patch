+    let base = capture_word(fb, buffer, Header::BASE_INSTANCE)?;
+    let width = capture_word(fb, buffer, Header::INDEX_BYTES)?;
+    let zero = crate::memory::leaf::k32(fb, 0)?;
+    let indexed = fb.binary(BinOp::INotEqual, width, zero)?;
+    // Do not speculatively read the index tail for a non-indexed draw: it has no tail.
+    // The index stream is shared by all instances and preserves duplicate references.
+    let vertex = fb
+        .if_(
+            cx,
+            indexed,
+            Box::new(move |fb, _| {
+                let first = capture_word(fb, buffer, Header::INDEX_WORD_OFFSET)?;
+                let two = crate::memory::leaf::k32(fb, 2)?;
+                let one = crate::memory::leaf::k32(fb, 1)?;
+                let half = fb.binary(BinOp::IEqual, width, two)?;
+                let packed = fb.binary(BinOp::ShiftRightLogical, vertex, one)?;
+                let offset = fb.select(half, packed, vertex)?;
+                let offset = fb.binary(BinOp::IAdd, first, offset)?;
+                let ptr = fb.module().global_value(buffer)?;
