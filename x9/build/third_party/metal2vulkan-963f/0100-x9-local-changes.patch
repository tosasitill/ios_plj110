+            raw.cmd_copy_image(command,self.from,vk::ImageLayout::GENERAL,
+                self.to,vk::ImageLayout::GENERAL,&self.regions);
+        });
+        core.barrier(Barrier::everything());
+        core.retain(self.held);
+    }
