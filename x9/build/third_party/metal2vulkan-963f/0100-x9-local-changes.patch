+        | InstKind::ShuffleVector { .. } | InstKind::ExtractValue { .. } | InstKind::InsertValue { .. }
+        | InstKind::Phi { .. } | InstKind::Ret(..) | InstKind::Br { .. } | InstKind::CondBr { .. }
