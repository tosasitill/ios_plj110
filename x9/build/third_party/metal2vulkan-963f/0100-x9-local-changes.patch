@@ -0,0 +1,118 @@
+//! Exact raw texel moves for linear shadows whose images have no transfer usage.
+//!
+//! A compatible unsigned-integer view preserves every bit, including NaN payloads.
+//! One invocation moves one texel. Byte and halfword physical-buffer accesses
+//! preserve adjacent bytes without a read/modify/write race. The caller validates
+//! every addressed row/layer against the retained backing before recording.
+use std::sync::Arc;
+use crate::budget::{Budget, Meter};
+use crate::device::Device;
+use crate::device::requirements::Requirements;
+use crate::error::{Error, Feature, Unsupported};
+use crate::pipeline::sym::{PushField, ResourceKind, ResourceSlot, Stage, Symbol};
+use crate::spirv::builder::{FunctionBuilder, ModuleBuilder};
+use crate::spirv::builder::constructs::{ArmEnd, ArmFn};
+use crate::spirv::error::BResult;
+use crate::spirv::ids::Value;
+use crate::spirv::ir::{BinOp, ConvOp, Dim, ExecMode, ExecModel, ImageOperands,
+    ImageType, ImageUsage, IoDir, MemAccess, StorageClass, TexelMemory, Type};
+use crate::vk::Format;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum RawShadowTexel { U8, U16, U32, U32x2, U32x4 }
+impl RawShadowTexel {
+    pub fn of_bytes(bytes:u32)->Option<Self> {Some(match bytes {1=>Self::U8,2=>Self::U16,4=>Self::U32,8=>Self::U32x2,16=>Self::U32x4,_=>return None})}
+    pub fn bytes(self)->u32 {match self {Self::U8=>1,Self::U16=>2,Self::U32=>4,Self::U32x2=>8,Self::U32x4=>16}}
+    pub fn lanes(self)->u32 {match self {Self::U32x2=>2,Self::U32x4=>4,_=>1}}
+    pub fn format(self)->Format {match self {Self::U8=>Format::R8_UINT,Self::U16=>Format::R16_UINT,Self::U32=>Format::R32_UINT,Self::U32x2=>Format::R32G32_UINT,Self::U32x4=>Format::R32G32B32A32_UINT}}
+    fn storage(self)->crate::spv::ImageFormat {use crate::spv::ImageFormat as I;match self {Self::U8=>I::R8ui,Self::U16=>I::R16ui,Self::U32=>I::R32ui,Self::U32x2=>I::Rg32ui,Self::U32x4=>I::Rgba32ui}}
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, PartialOrd, Ord)]
+pub enum RawShadowDirection { IntoImage, FromImage }
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RawShadowModule {pub spirv:Arc<[u32]>,pub requirements:Requirements}
+impl RawShadowModule {pub const PUSH_BYTES:u32=40;pub const LOCAL_SIZE:u32=64;}
+const IMAGE:ResourceSlot=ResourceSlot{stage:Stage::Kernel,kind:ResourceKind::Texture,index:0};
+fn k(f:&mut FunctionBuilder<'_>,n:u32)->BResult<Value>{let c=f.u32_const(n)?;f.module().const_value(c)}
+
+pub fn raw_shadow_module(device:&Device,texel:RawShadowTexel,direction:RawShadowDirection)->Result<RawShadowModule,Error>{
+    let into=direction==RawShadowDirection::IntoImage;
+    let mut b=ModuleBuilder::new();
+    let u=b.ty(Type::Int{width:32,signed:false})?;
+    let u64_=b.ty(Type::Int{width:64,signed:false})?;
+    let unit=(texel.bytes()/texel.lanes()).min(4);
+    let element=b.ty(Type::Int{width:(unit*8) as u8,signed:false})?;
+    let v3=b.ty(Type::Vector{elem:u,len:3})?;
+    let v4=b.ty(Type::Vector{elem:u,len:4})?;
+    let shape=b.push_member(PushField::DispatchRegion,v4,0)?;
+    let strides=b.push_member(PushField::StageInRegion,v4,16)?;
+    let address=b.push_member(PushField::CommandRecordsAddress,u64_,32)?;
+    let push=b.push_global()?;
+    let it=b.ty(Type::Image(ImageType{sampled_type:u,dim:Dim::D2,depth:false,arrayed:true,multisampled:false,
+        usage:if into {ImageUsage::Storage}else{ImageUsage::Sampled},
+        format:if into {texel.storage()}else{crate::spv::ImageFormat::Unknown}}))?;
+    let image=b.resource(IMAGE,StorageClass::UniformConstant,it)?;
+    let gid=b.builtin(crate::spv::BuiltIn::GlobalInvocationId,IoDir::Input,v3)?;
+    let void=b.ty(Type::Void)?;
+    let mut f=b.function(void)?;
+    let zero=k(&mut f,0)?;
+    let gv=f.module().global_value(gid)?;
+    let gv=f.load(gv,MemAccess::default())?;
+    let x=f.composite_extract(gv,&[0])?;let y=f.composite_extract(gv,&[1])?;let z=f.composite_extract(gv,&[2])?;
+    let pv=f.module().global_value(push)?;
+    let mut values=Vec::new();
+    for field in [shape.index,strides.index,address.index] {
+        let i=k(&mut f,field)?;let p=f.access_chain(pv,&[i])?;values.push(f.load(p,MemAccess::default())?);
+    }
+    let s=values[0];let st=values[1];let base=values[2];
+    let width=f.composite_extract(s,&[2])?;let height=f.composite_extract(s,&[3])?;
+    let a=f.binary(BinOp::ULessThan,x,width)?;let c=f.binary(BinOp::ULessThan,y,height)?;
+    let inside=f.binary(BinOp::LogicalAnd,a,c)?;
+    let ig=f.module().global_value(image)?;
+    let image=f.load(ig,MemAccess::default())?;
+    let copy:ArmFn<'_,()>=Box::new(move|f,_|{
+        let x0=f.composite_extract(s,&[0])?;let y0=f.composite_extract(s,&[1])?;
+        let layer=f.composite_extract(st,&[2])?;
+        let ix=f.binary(BinOp::IAdd,x0,x)?;let iy=f.binary(BinOp::IAdd,y0,y)?;let iz=f.binary(BinOp::IAdd,layer,z)?;
+        let coord=f.composite_construct(v3,&[ix,iy,iz])?;
+        let row=f.composite_extract(st,&[0])?;let slice=f.composite_extract(st,&[1])?;
+        let mut offset=k(f,0)?;offset=f.convert(ConvOp::UConvert,offset,u64_)?;
+        for (index,stride) in [(x,k(f,texel.bytes())?),(y,row),(z,slice)] {
+            let i=f.convert(ConvOp::UConvert,index,u64_)?;let t=f.convert(ConvOp::UConvert,stride,u64_)?;
+            let at=f.binary(BinOp::IMul,i,t)?;offset=f.binary(BinOp::IAdd,offset,at)?;
+        }
+        let first=f.binary(BinOp::IAdd,base,offset)?;
+        let fetched=if into {None}else{Some(f.fetch(image,coord,&ImageOperands{lod:Some(zero),..ImageOperands::default()})?)};
+        let mut channels=Vec::new();
+        for lane in 0..texel.lanes() {
+            let off=k(f,lane*unit)?;let off=f.convert(ConvOp::UConvert,off,u64_)?;
+            let at=f.binary(BinOp::IAdd,first,off)?;
+            let place=f.device_place(at,element)?;
+            let mem=MemAccess{aligned:Some(unit),..MemAccess::default()};
+            if into {
+                let value=f.load(place,mem)?;
+                channels.push(if unit==4 {value}else{f.convert(ConvOp::UConvert,value,u)?});
+            } else {
+                let value=f.composite_extract(fetched.expect("from-image module"),&[lane])?;
+                let value=if unit==4 {value}else{f.convert(ConvOp::UConvert,value,element)?};
+                f.store(place,value,mem)?;
+            }
+        }
+        if into {
+            while channels.len()<4 {channels.push(zero);}
+            let value=f.composite_construct(v4,&channels)?;
+            f.write(image,coord,value,&ImageOperands::default(),TexelMemory::default())?;
+        }
+        Ok(ArmEnd::FallThrough(Vec::new()))
+    });
+    f.if_(&mut (),inside,copy,None)?;f.ret(None)?;let entry=f.finish()?;
+    b.entry(ExecModel::GLCompute,entry,vec![ExecMode::LocalSize{x:RawShadowModule::LOCAL_SIZE,y:1,z:1}])?;
+    let m=b.finalize()?;let profile=device.profile();
+    profile.check(m.requirements()).map_err(|c|Error::Unsupported(Unsupported::needs(Feature::Format,c)))?;
+    let mut meter=Meter::new(&Budget::default());crate::spirv::verify::verify(&m,profile,&mut meter)?;
+    let r=crate::spirv::serialize::serialize(m)?;
+    let words=crate::spirv::serialize::relocate(&r,&|sym:&Symbol|match sym {
+        Symbol::DescriptorSet(_)=>Some(0),Symbol::Binding(s) if *s==IMAGE=>Some(0),_=>None,
+    })?;
+    Ok(RawShadowModule{spirv:words.into(),requirements:r.requirements})
+}
