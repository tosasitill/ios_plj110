+    let (Some(buffer), Some(invocation)) = (d.capture_buffer, d.capture_invocation) else {
+        return Err(cx.fail("capture declaration missing"));
+    };
+    let p = fb.module().global_value(invocation)?;
+    let id = fb.load(p, MemAccess::default())?;
+    let vertex = fb.composite_extract(id, &[0])?;
+    let instance = fb.composite_extract(id, &[1])?;
+    Ok((buffer, vertex, instance))
