+
+/// A kept empty block that stayed empty for `AGED_EMPTY_FOR` goes even where it is its pool's
+/// last one — what `stale` never takes — the earliest emptied first; one that emptied later
+/// stays until its own time is up. A block added with nothing placed in it, which has no
+/// emptied time, is never taken.
+#[test]
+fn a_kept_empty_block_aged_out_goes_even_the_last_one() {
+    let start = Instant::now();
+    let mut pool: Pool<&str> = Pool::default();
+    let first = pool.add(256, false, "first", 256);
+    let second = pool.add(256, false, "second", 256);
+    assert_eq!(pool.release(first, 0, 256, start), None);
+    assert_eq!(pool.release(second, 0, 256, start + AGED_EMPTY_FOR / 2), None);
+    assert_eq!(
+        pool.aged(start + AGED_EMPTY_FOR - Duration::from_nanos(1)),
+        None,
+        "neither stayed empty so long"
+    );
+    assert_eq!(
+        pool.aged(start + AGED_EMPTY_FOR),
+        Some("first"),
+        "the earliest emptied goes first"
+    );
+    assert_eq!(
+        pool.aged(start + AGED_EMPTY_FOR),
+        None,
+        "the second has not been empty so long yet"
+    );
+    assert_eq!(
+        pool.stale(start + AGED_EMPTY_FOR * 2),
+        None,
+        "stale keeps the last kept block, however long"
+    );
+    assert_eq!(
+        pool.aged(start + AGED_EMPTY_FOR * 2),
+        Some("second"),
+        "the last kept block goes too"
+    );
+    assert_eq!(pool.blocks(), 0);
+    assert_eq!(pool.turnover(), (2, 2));
+    // The room a keeper made: added empty, never placed in, no emptied time.
+    let mut pool: Pool<&str> = Pool::default();
+    let _room = pool.add(256, false, "room", 0);
+    assert_eq!(
+        pool.aged(start + AGED_EMPTY_FOR * 4),
+        None,
+        "a block that never held a placement is not taken"
+    );
+    assert_eq!(pool.blocks(), 1);
 }
 
 #[test]
