+/* X9: metal2vulkan binds index buffers with the exact size of the indices a
+ * draw reads (vkCmdBindIndexBuffer2). On the X9 Mali v14 path the last
+ * triangle of such draws is observed lost or redirected to vertex 0, as if the
+ * tail of a tight INDEX_BUFFER_SIZE reads as zero. Widen the bound range to
+ * the end of the VkBuffer (never past it). Exact boot-arg token x9i0 keeps the
+ * requested size, for A/B comparison. */
+static bool
+x9_ib_widen(void)
+{
+   static int mode = -1;
+   int m = __atomic_load_n(&mode, __ATOMIC_RELAXED);
+   if (m >= 0)
+      return m;
+   m = 1;
+   char args[4096] = {0};
+   size_t bytes = sizeof(args) - 1;
+   if (!sysctlbyname("kern.bootargs", args, &bytes, NULL, 0)) {
+      args[sizeof(args) - 1] = 0;
+      for (const char *p = args; *p;) {
+         while (*p && (unsigned char)*p <= 32)
+            p++;
+         const char *end = p;
+         while (*end && (unsigned char)*end > 32)
+            end++;
+         if (end - p == 4 && !memcmp(p, "x9i0", 4))
+            m = 0;
+         p = end;
+      }
+   }
+   __atomic_store_n(&mode, m, __ATOMIC_RELAXED);
+   x9_panvk_log("X9 PANVK IB policy: proc=%s widen=%d;1=bind to VkBuffer end 0=exact (x9i0)",
+                getprogname(), m);
+   return m;
+}
+#endif
