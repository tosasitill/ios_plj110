+/* X9 pad guard (vertex shaders, panvk_vX_shader.c): pad non-indexed
+ * triangle-list draws to a multiple of 12. Default on; boot-arg token x9g0
+ * keeps upstream counts (the Metal frontend snapshot padding is separate). */
+static int __attribute__((unused))
+x9_pad_guard_mode(void)
+{
+   static int mode = -1;
+   int m = __atomic_load_n(&mode, __ATOMIC_RELAXED);
+   if (m >= 0)
+      return m;
+   m = 1;
+   char args[4096] = {0};
+   size_t bytes = sizeof(args) - 1;
+   if (!sysctlbyname("kern.bootargs", args, &bytes, NULL, 0)) {
+      args[sizeof(args) - 1] = 0;
+      for (const char *p = args; *p;) {
+         while (*p && (unsigned char)*p <= 32)
+            p++;
+         const char *end = p;
+         while (*end && (unsigned char)*end > 32)
+            end++;
+         if (end - p == 4 && !memcmp(p, "x9g0", 4))
+            m = 0;
+         p = end;
+      }
+   }
+   __atomic_store_n(&mode, m, __ATOMIC_RELAXED);
+   x9_panvk_log("X9 PAD GUARD: proc=%s mode=%d;1=pad non-indexed triangle lists to 12 with VS vertex-id guard 0=off (x9g0)",
+                getprogname(), m);
+   return m;
+}
