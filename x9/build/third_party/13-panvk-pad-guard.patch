    pan_nir_lower_mediump_io(nir);
 }
 
+#if PAN_ARCH >= 9 && defined(X9_NATIVE_KMOD)
+/* X9 pad guard. On v14 a non-indexed triangle-list draw whose vertex count is
+ * not a multiple of 12 misplaces vertices of its last, partial vertex group
+ * (rev240/241: 9-vertex Control Center draws exact once padded to 12). The
+ * Metal frontend used to pad by copying the last vertex record at encode
+ * time, which (a) does not neutralise shaders that derive positions from
+ * vertex_id and (b) misses later CPU/GPU writes to the buffer. Instead the
+ * draw is padded here and every vertex shader runs its whole body only for
+ * vertex_id < vs.x9_vertex_limit; extra lanes load nothing, store nothing
+ * and write position = 0 (zero-area, w = 0). On Valhall malloc-IDVS,
+ * load_vertex_id is the absolute ID (firstVertex + i). */
+static bool
+x9_pad_guard_vs(nir_shader *nir)
+{
+   if (nir->info.stage != MESA_SHADER_VERTEX)
+      return false;
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+   nir_intrinsic_instr *pos = NULL;
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_intrinsic)
+            continue;
+         nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+         if (intr->intrinsic == nir_intrinsic_load_push_constant &&
+             nir_intrinsic_base(intr) == SYSVALS_PUSH_CONST_BASE &&
+             nir_src_is_const(intr->src[0]) &&
+             nir_src_as_uint(intr->src[0]) ==
+                sysval_offset(graphics, vs.x9_vertex_limit))
+            return false; /* already guarded */
+         if (!pos && intr->intrinsic == nir_intrinsic_store_output &&
+             nir_intrinsic_io_semantics(intr).location == VARYING_SLOT_POS)
+            pos = intr;
+      }
+   }
+   if (!pos)
+      return false;
+   const unsigned base = nir_intrinsic_base(pos);
+   const nir_alu_type type = nir_intrinsic_src_type(pos);
+   const nir_io_semantics sem = nir_intrinsic_io_semantics(pos);
+
+   nir_cf_list body;
+   nir_cf_extract(&body, nir_before_impl(impl), nir_after_impl(impl));
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   nir_def *vid = nir_load_vertex_id(&b);
+   nir_def *limit = load_sysval(&b, graphics, 32, vs.x9_vertex_limit);
+   nir_if *nif = nir_push_if(&b, nir_ult(&b, vid, limit));
+   nir_cf_reinsert(&body, b.cursor);
+   nir_push_else(&b, nif);
+   nir_def *zero = nir_imm_zero(&b, 4, nir_alu_type_get_type_size(type));
+   nir_store_output(&b, zero, nir_imm_int(&b, 0), .base = base,
+                    .component = 0, .write_mask = 0xf, .src_type = type,
+                    .io_semantics = sem);
+   nir_pop_if(&b, nif);
+   return nir_progress(true, impl, nir_metadata_none);
+}
+#endif
