# device dumps: persist/modemst/fsg hold IMEI + calibration; live DT holds the serial
backup/
dtb/
recovery/
# third-party/Apple sources fetched for reading
research/
shim/out/
xnu/out/
xnu/out-*/
__pycache__/
# X9 artifacts: build outputs, logs, device dumps
x9/out/
work/**/build-*/
work/**/*.log
*.o
# objects whose compile command is not reconstructed yet (see x9/kernel/README.md)
!x9/kernel/prebuilt/*.o
# machine-local build paths
x9/build/local.json
# vendor Wi-Fi firmware embedded at build time (x9/tools/wifi_firmware.py)
x9/kernel/generated/x9_wifi_firmware.inc
x9/kernel/generated/x9_bt_firmware.inc
x9/kernel/generated/x9_gps_firmware.inc
# device Wi-Fi NVRAM (MAC + calibration) embedded at build time (x9/tools/wifi_nvram.py)
x9/kernel/generated/x9_wifi_nvram.inc
# Vendor modem OTA configs embedded at build time; never commit firmware.
x9/kernel/generated/x9_mdota.inc
x9/kernel/generated/x9_baseband_firmware.inc
x9/kernel/generated/x9_carrier_cbn.inc
x9/kernel/generated/x9_torch_bridge.inc
x9/kernel/generated/x9_camera_bridge.inc
x9/kernel/generated/x9_microphone_hal.inc
x9/kernel/generated/x9_haptic_hal.inc
x9/kernel/generated/x9_speaker_hal.inc
x9/kernel/generated/x9_camera_sensor_tables.inc

# Local dependency snapshots, Apple inputs and private device state
.local/
.DS_Store

# Local tooling / credentials: never commit (cc-remote, acpc, ssh, agent state)
.zcode/
.claude/
.cc-remote/
.acpc/
acpc/
cc-remote/
*.key
*.pem
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
.env
.env.*
*.log.json
ssh.debug.log
auth-status*.json
acp-*.jsonl
